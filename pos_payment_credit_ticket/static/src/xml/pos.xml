<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-extend="PosTicket">
        <t t-jquery="table.receipt-change" t-operation="after">
            <table t-if="widget.pos.get_client()" class='client-credit'>
                <tr>
                    <td>Available Credit:</td>
                    <td class="pos-right-align">
                        <t t-esc="widget.format_currency(widget.pos.get_client().credit_amount)"/>
                    </td>
                </tr>
            </table>
        </t>
        <t t-jquery="div.receipt-user" t-operation="after">
            <div t-if="widget.pos.get_client()" class="receipt-partner">
                Client: <t t-esc="widget.pos.get_client().name"/><br />
            </div>
        </t>
    </t>
</templates>
