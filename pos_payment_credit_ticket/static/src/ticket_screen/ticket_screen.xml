<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('header-row')]" position="inside">
            <div class="col end p-2">Available Credit</div>
        </xpath>
        <xpath
            expr="//t[@t-if='!ui.isSmall']/div[hasclass('order-row')]"
            position="inside"
        >
            <div class="col end p-2">
                <div>
                    <t
                        t-out="env.utils.formatCurrency(order.partner_id?.credit_amount)"
                    />
                </div>
            </div>
        </xpath>
    </t>
</templates>
