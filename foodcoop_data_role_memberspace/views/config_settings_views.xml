<?xml version="1.0" ?>
<odoo>
    <record id="res_config_settings_view_form_memberspace" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="coop_memberspace.res_config_settings_view_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='memberspace_shift_exchange_settings']"
                position="attributes"
            >
                <attribute
                    name="groups"
                >base.group_system,foodcoop_data_role.group_Foodcoop_Admin</attribute>
            </xpath>
        </field>
    </record>
</odoo>
