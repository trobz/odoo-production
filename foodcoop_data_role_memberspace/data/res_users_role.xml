<?xml version="1.0"?>
<odoo>
    <record id="res_users_role_Member" model="res.users.role">
        <field name="name">Member</field>
        <field name="group_id" ref="foodcoop_data_role_memberspace.group_Member"/>
        <field name="implied_ids" eval="[
            Command.link(ref('foodcoop_data_role_memberspace.group_member_restrict')),
            Command.link(ref('coop_memberspace.group_memberspace')),
        ]"/>
    </record>

    <!-- Add memberspace group to Foodcoop Admin for coops where memberspace is installed -->
    <record id="foodcoop_data_role.res_users_role_Foodcoop_Admin" model="res.users.role">
        <field
            name="implied_ids"
            eval="[Command.link(ref('coop_memberspace.group_memberspace'))]"
        />
    </record>
</odoo>
