<odoo>
    <record id="view_shift_template_wizard_form" model="ir.ui.view">
        <field name="name">Create Shift</field>
        <field name="model">create.shifts.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Shifts">
                <group>
                    <field name="last_shift_date" readonly="1" />
                    <field name="date_from" required="1" />
                    <field name="date_to" required="1" />
                </group>
                <footer>
                    <button
                        name="create_shifts"
                        string="Create Shifts"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_createshifts_multi" model="ir.actions.act_window">
        <field name="name">Create Shifts</field>
        <field name="res_model">create.shifts.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="coop_shift.model_shift_template" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
