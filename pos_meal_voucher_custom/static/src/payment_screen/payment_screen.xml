<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute
                name="t-on-click"
            >() => paymentMethod.meal_voucher_type !== false ? this.addNewPaymentLine(paymentMethod, true) : this.addNewPaymentLine(paymentMethod)</attribute>
        </xpath>
    </t>
</templates>
