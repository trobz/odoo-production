<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <!--Email template -->
    <record id="email_notify_assignee" model="mail.template">
        <field name="name">Task: Notify the Assignee</field>
        <field name="email_from">{{ (object.company_id.email or '') }}</field>
        <field name="partner_to">{{ object.get_partner_assignee_ids() }}</field>
        <field name="subject">Assignment of task: {{ object.name }}</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="auto_delete" eval="False" />
        <field name="lang">{{ object.get_lang() or user.lang or 'en_US' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.get_partner_assignee_names() or ''" />, </p>
                <p>
    <t t-out="user.name or ''" /> has assigned to you a new task:
</p>
                <ul>
                    <li>
                        <t t-out="object.name or ''" />
                    </li>
                </ul>

                <p>Thank you, </p>
            </div>
        </field>
    </record>
</odoo>
