<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_coop_produce_stock_inventory_form" model="ir.ui.view">
        <field name="name">stock.inventory.form</field>
        <field name="model">stock.inventory</field>
        <field name="priority" eval="1001" />
        <field name="arch" type="xml">
            <form string="Inventory F&amp;V">
                <header>
                    <button
                        name="action_state_to_done"
                        string="Validate"
                        type="object"
                        invisible="state == 'done'"
                        class="oe_highlight"
                        groups="stock.group_stock_manager"
                        context="{'check_date_begin': True}"
                    />
                    <button
                        name="action_generate_planification"
                        invisible="state != 'done'"
                        string="Generate Week Planification"
                        type="object"
                        class="oe_highlight"
                        groups="stock.group_stock_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done"
                    />
                </header>
                <sheet>
                    <field name="company_id" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group col="6" name="date_info">
                        <field name="date" string="Date" readonly="state == 'done'" />
                        <field name="week_number" string="Week Number" />
                        <field
                            name="location_ids"
                            widget="many2many_tags"
                            readonly="state != 'draft'"
                            required="1"
                        />
                        <field
                            name="exclude_sublocation"
                            readonly="state in ['in_progress', 'done']"
                            required="1"
                        />
                        <field name="hide_initialisation" invisible="state == 'done'" />
                        <field
                            name="week_date"
                            invisible="state != 'done'"
                            required="state == 'done'"
                        />
                    </group>
                    <separator
                        string="Initialisation"
                        invisible="hide_initialisation or state == 'done'"
                    />
                    <group invisible="hide_initialisation or state == 'done'">
                        <group>
                            <field
                                name="categ_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                readonly="state in ('done', 'cancel')"
                            />
                        </group>
                        <group>
                            <button
                                name="action_add_category_supplier"
                                string="Add"
                                type="object"
                                class="oe_highlight"
                                groups="stock.group_stock_manager"
                            />
                            <button
                                name="action_state_to_draft"
                                string="Reset"
                                type="object"
                                class="oe_highlight"
                                groups="stock.group_stock_manager"
                            />
                        </group>
                    </group>
                    <group invisible="hide_initialisation or state == 'done'">
                        <group>
                            <field
                                name="supplier_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                readonly="state in ('done', 'cancel')"
                            />
                        </group>
                        <group>
                            <button
                                name="action_add_category_supplier"
                                string="Add"
                                type="object"
                                class="oe_highlight"
                                groups="stock.group_stock_manager"
                            />
                            <button
                                name="init_with_theorical_qty"
                                string="Init Qties"
                                type="object"
                                class="oe_highlight"
                                groups="stock.group_stock_manager"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Product inventory">
                            <field
                                name="stock_quant_ids"
                                string="Inventory Details"
                                readonly="state == 'done'"
                                context="{'order_planning_context':True}"
                            >
                                <list string="Inventory Details" editable="bottom">
                                    <field name="product_id" readonly="True" />
                                    <field name="default_packaging" />
                                    <field
                                        name="packaging_qty"
                                        string="Qty/Def. Pack"
                                    />
                                    <field name="qty_stock" autofocus="autofocus" />
                                    <field name="qty_loss" string="Adjustment" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Inventory Adjustments"
                            invisible="state != 'done'"
                        >
                            <field
                                name="stock_move_ids"
                                context="{'order_planning_context':True}"
                            >
                                <list string="Stock Moves">
                                    <field name="product_id" />
                                    <field name="quantity_product_uom" />
                                    <field
                                        name="product_uom_id"
                                        options="{'no_open': True, 'no_create': True}"
                                        string="Unit of Measure"
                                        groups="uom.group_uom"
                                    />
                                    <!-- <button
                                        name="stock.action_stock_scrap"
                                        string="Scrap Products"
                                        type="action"
                                        icon="terp-gtk-jump-to-ltr"
                                        context="{'scrap': True}"
                                        invisible="state not in ('draft', 'waiting', 'confirmed', 'assigned')"
                                        groups="stock.group_stock_user"
                                    /> -->
                                    <field name="location_id" />
                                    <field name="location_dest_id" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_coop_produce_stock_inventory_tree" model="ir.ui.view">
        <field name="name">coop_produce.stock.inventory.tree</field>
        <field name="model">stock.inventory</field>
        <field name="arch" type="xml">
            <list string="Lot Inventory">
                <field name="week_number" string="Week Number" />
                <field name="date" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_coop_produce_stock_inventory_filter" model="ir.ui.view">
        <field name="name">coop_produce.stock.inventory.filter</field>
        <field name="model">stock.inventory</field>
        <field name="arch" type="xml">
            <search string="Search Inventory">
                <field name="name" string="Inventory Reference" />
                <field name="date" string="date" />
                <field name="week_number" string="Week Number" />
                <field name="company_id" groups="base.group_multi_company" />
                <group expand="0" string="Group By">
                    <filter
                        string="Week"
                        name="week"
                        domain="[]"
                        context="{'group_by':'date'}"
                    />
                    <filter
                        string="Week Number"
                        name="week_number"
                        domain="[]"
                        context="{'group_by':'week_number'}"
                        help="Physical Inventories by Week Number"
                    />
                </group>
            </search>
        </field>
    </record>

    <record
        id="action_view_coop_produce_stock_inventories"
        model="ir.actions.act_window"
    >
        <field name="name">F&amp;V Inventory</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.inventory</field>
        <field name="search_view_id" ref="view_coop_produce_stock_inventory_filter" />
        <field name="context">{
            'default_weekly_inventory': True,
            'default_name':'Inventory of V&amp;F'
        }</field>
        <field name="domain">[('weekly_inventory', '=', True)]</field>
        <field name="view_mode">list,form</field>
    </record>

    <record
        id="action_coop_produce_stock_inventories_tree"
        model="ir.actions.act_window.view"
    >
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_coop_produce_stock_inventory_tree" />
        <field name="act_window_id" ref="action_view_coop_produce_stock_inventories" />
    </record>

    <record
        id="action_coop_produce_stock_inventories_form"
        model="ir.actions.act_window.view"
    >
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_coop_produce_stock_inventory_form" />
        <field name="act_window_id" ref="action_view_coop_produce_stock_inventories" />
    </record>

    <menuitem
        id="menu_inventory_fruits_vegetables"
        name="V&amp;F Inventory"
        parent="stock.menu_stock_inventory_control"
        groups="stock.group_stock_manager"
        sequence="60"
        action="action_view_coop_produce_stock_inventories"
    />
</odoo>
