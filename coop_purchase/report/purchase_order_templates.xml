<?xml version="1.1" encoding="utf-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document"
        inherit_id="purchase.report_purchaseorder_document"
        priority="99"
    >
        <xpath
            expr="//table[hasclass('o_main_table')]/thead/tr/th[@name='th_quantity']"
            position="replace"
        >
            <th class="text-end">
                <strong>Nb of Packages</strong>
            </th>
            <th class="text-end">
                <strong>Package qty</strong>
            </th>
            <th class="text-end">
                <strong>Qty</strong>
            </th>
        </xpath>

        <xpath
            expr="//table[hasclass('o_main_table')]/thead/tr/th[@name='th_price_unit']"
            position="after"
        >
            <th class="text-end">
                <strong>Package Price</strong>
            </th>
        </xpath>

        <xpath
            expr="//t[@t-if='not line.display_type']/td[span[@t-field='line.product_qty']]"
            position="replace"
        >
            <td class="text-end">
                <span t-field="line.product_qty_package" />
            </td>
            <td class="text-end">
                <span t-field="line.package_qty" />
            </td>
            <td class="text-end">
                <span t-field="line.product_qty" />
            </td>
        </xpath>

        <xpath
            expr="//t[@t-if='not line.display_type']/td[span[@t-field='line.price_unit']]"
            position="after"
        >
            <td class="text-end">
                <span t-field="line.package_price" />
            </td>
        </xpath>

        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.date_planned" class="col-3 bm-2">
                <strong>Delivery Date:</strong>
                <p t-field="o.date_planned" />
            </div>
            <div t-if="o.create_uid" class="col-3 bm-2">
                <strong>Creator:</strong>
                <div
                    t-field="o.create_uid.partner_id"
                    t-options='{"widget": "contact", "fields": ["name", "phone"], "phone_icons": true}'
                />
            </div>
        </xpath>
    </template>
</odoo>
