<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="supplier_info_update_act" model="ir.actions.act_window">
        <field name="name">Update Prices</field>
        <field name="res_model">supplier.info.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_supplier_info_update" model="ir.ui.view">
        <field name="name">supplier.info.update.form.view</field>
        <field name="model">supplier.info.update</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <notebook>
                        <page string="Lines">
                            <group>
                                <field
                                    name="line_ids"
                                    colspan="4"
                                    view_mode="list"
                                    nolabel="1"
                                    context="{'form_view_ref': False}"
                                >
                                    <list
                                        create="false"
                                        delete="false"
                                        editable="bottom"
                                    >
                                        <field name="product_id" readonly="1" />
                                        <field
                                            name="supplier_price_unit"
                                            readonly="1"
                                            force_save="1"
                                        />
                                        <field
                                            name="supplier_discount"
                                            readonly="1"
                                            force_save="1"
                                        />
                                        <field name="price_policy" readonly="1" />
                                        <field name="price_unit" default_focus="1" />
                                        <field
                                            name="discount"
                                            default_focus="1"
                                            optional="hide"
                                            column_invisible="not parent.show_discount"
                                        />
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        name="update_prices"
                        string="Validate"
                        type="object"
                        class="btn btn-primary"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
