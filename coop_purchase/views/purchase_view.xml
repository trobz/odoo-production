<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="purchase_order_form">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='date_planned']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='price_subtotal']" position="after">
                <field name="price_total" />
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="price_discounted" />
            </xpath>
            <field name="taxes_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="analytic_distribution" position="replace" />
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute
                    name="decoration-success"
                >product_qty==qty_invoiced</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_done']" position="after">
                <button
                    name="button_update_prices"
                    type="object"
                    string="Upd. Prices"
                    class="btn btn-primary"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_id']"
                position="before"
            >
                <field name="product_default_code" />
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="context">{'display_default_code': False}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//field[@name='product_packaging_qty']"
                position="attributes"
            >
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//field[@name='product_packaging_id']"
                position="attributes"
            >
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_line_tree" model="ir.ui.view">
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="id" invisible="1" />
                <field name="order_id" invisible="1" />
                <field name="partner_id" invisible="1" />
                <field name="product_id" />
                <field name="name" />
                <field name="date_planned" invisible="1" />
                <field name="company_id" groups="base.group_multi_company" />
                <field
                    name="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                    invisible="1"
                />
                <field name="product_qty_package" />
                <field name="package_qty" />
                <field name="indicative_package" invisible="1" />
                <field name="product_qty" />
                <field name="qty_received" />
                <field name="qty_invoiced" />
                <field name="product_uom" groups="uom.group_uom" />
                <field name="price_unit" />
                <field name="price_discounted" />
                <field name="price_policy" />
                <field name="discount" />
                <field name="taxes_id" widget="many2many_tags" invisible="1" />
                <field name="price_subtotal" widget="monetary" />
                <field name="price_total" />
            </list>
        </field>
    </record>

    <record id="purchase.menu_purchase_rfq" model="ir.ui.menu">
        <field name="sequence" eval="2" />
    </record>

    <record id="purchase.menu_product_pricelist_action2_purchase" model="ir.ui.menu">
        <field name="parent_id" ref="purchase.menu_procurement_management" />
        <field name="sequence" eval="120" />
    </record>

    <menuitem
        id="menu_purchase_control"
        name="Control"
        parent="purchase.menu_purchase_root"
        sequence="4"
    />
    <menuitem
        id="menu_purchase_control_bills"
        name="Vendor Bills"
        action="account.action_move_in_invoice"
        parent="menu_purchase_control"
        sequence="13"
    />
    <menuitem
        id="menu_purchase_control_refunds"
        name="Vendor Refunds"
        action="account.action_move_in_refund_type"
        parent="menu_purchase_control"
        sequence="15"
    />
</odoo>
