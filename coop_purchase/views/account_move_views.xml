<?xml version="1.0" ?>
<odoo>
    <record id="invoice_supplier_form" model="ir.ui.view">
        <field name="name">invoice.supplier.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute
                    name="options"
                >{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}</attribute>
            </field>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='discount']"
                position="attributes"
            >
                <attribute
                    name="groups"
                >account.group_account_invoice,sale.group_discount_per_so_line</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                position="after"
            >
                <field name="base_price" />
            </xpath>
            <xpath expr="//header/button[@name='button_draft']" position="after">
                <button
                    name="button_update_prices"
                    type="object"
                    string="Upd. Prices"
                    invisible="move_type not in ('in_invoice', 'in_refund')"
                    class="btn btn-primary"
                />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
                <attribute name="limit">500</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="before"
            >
                <field name="product_default_code" />
            </xpath>
        </field>
    </record>
</odoo>
