<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_computed_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">view.compute.purchase.order.for.inherit.discount</field>
        <field name="model">computed.purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_compute_order.view_computed_purchase_order_form"
        />
        <field name="arch" type="xml">
            <field name="discount" position="attributes">
                <attribute name="string">Discount (%)</attribute>
            </field>
            <xpath expr="//field[@name='line_ids']/list" position="attributes">
                <attribute name="limit">500</attribute>
            </xpath>
        </field>
    </record>
    <record
        id="purchase_compute_order.action_purchase_order_line_tree"
        model="ir.actions.act_window"
    >
        <field name="view_id" ref="view_purchase_order_line_tree" />
    </record>
</odoo>
