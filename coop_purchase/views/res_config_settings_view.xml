<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_purchase" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='matrix_setting_container']" position="inside">
                <setting
                    id="update_main_vendor_on_update_vendor_price"
                    string="Update Vendors Prices"
                    help='The action "Update Vendors Prices" defines Vendor as Main Vendor of selected products.'
                >
                    <field name="update_main_vendor_on_update_vendor_price" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
