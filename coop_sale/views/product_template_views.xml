<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view_hide_service_fields">
        <field name="name">product.template.form.hide.service.fields</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_timesheet.view_product_timesheet_form" />
        <field name="arch" type="xml">
            <field name="invoice_policy" position="attributes">
                <attribute name="invisible" add="type == 'service'" separator="or" />
            </field>
            <field name="service_tracking" position="attributes">
                <attribute name="invisible" add="type == 'service'" separator="or" />
            </field>
            <field name="product_tooltip" position="attributes">
                <attribute name="invisible" add="type == 'service'" separator="or" />
            </field>
            <xpath
                expr="//label[@for='service_upsell_threshold']"
                position="attributes"
            >
                <attribute name="invisible" add="type == 'service'" separator="or" />
            </xpath>
            <xpath
                expr="//div[field[@name='service_upsell_threshold']]"
                position="attributes"
            >
                <attribute name="invisible" add="type == 'service'" separator="or" />
            </xpath>
        </field>
    </record>
</odoo>
