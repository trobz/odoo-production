<odoo>
    <record model="account.journal" id="sale_capital_journal">
        <field name="name">Sale Demo Capital Fundraising Journal</field>
        <field name="type">sale</field>
        <field name="code">S-CF</field>
        <field name="is_capital_fundraising" eval="True" />
    </record>

    <record model="account.journal" id="capital_journal">
        <field name="name">Payment Demo Capital Fundraising Journal</field>
        <field name="type">bank</field>
        <field name="code">P-CF</field>
        <field name="is_payment_capital_fundraising" eval="True" />
        <field name="default_account_id" ref="unpaid_capital_account_category_A" />
    </record>
</odoo>
