<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath
            expr="//t[@t-if=&quot;line.payment_status == 'pending'&quot;]"
            position="attributes"
        >
            <attribute
                name="t-if"
            >line.payment_status == 'pending' and line.payment_method_id.use_payment_terminal !== 'credit'</attribute>
        </xpath>
        <xpath
            expr="//t[@t-elif=&quot;line.payment_status == 'done'&quot;]"
            position="attributes"
        >
            <attribute
                name="t-elif"
            >line.payment_status == 'done' and line.payment_method_id.use_payment_terminal !== 'credit'</attribute>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath
            expr="//section[@t-if='pos.paymentCreditInProgress']"
            position="attributes"
        >
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>

</templates>
