<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.form.coop.pos.access</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='refund']" position="attributes">
                <attribute name="groups">coop_pos_access.pos_refund_group</attribute>
            </xpath>
        </field>
    </record>

    <record id="pos_order_return_view_pos_order_form" model="ir.ui.view">
        <field name="name">pos.order.return.form.coop.pos.access</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="pos_order_return.view_pos_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_partial_refund']" position="attributes">
                <attribute name="groups">coop_pos_access.pos_refund_group</attribute>
            </xpath>
        </field>
    </record>
</odoo>
