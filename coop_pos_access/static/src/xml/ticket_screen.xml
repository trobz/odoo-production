<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="coop_pos_access.TicketScreen"
        t-inherit="point_of_sale.TicketScreen"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('subpads')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath
            expr="//div[@t-att-class=&quot;{ 'highlight text-danger': !getHasItemsToRefund() }&quot;]"
            position="attributes"
        >
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//button[hasclass('edit-order-payment')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
</templates>
