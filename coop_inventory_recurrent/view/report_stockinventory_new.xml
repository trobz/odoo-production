<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_inventory_new_layout">
        <t t-call="web.html_container">
            <t t-set="variants" t-value="quants.get_copi_variants()" />
            <t
                t-set="o"
                t-value="variants[0]['obj'][0] if variants and variants[0]['obj'] else False"
            />
            <t t-call="coop_inventory.external_layout_standard_inventory">
                <t t-foreach="variants" t-as="variant">
                    <t t-set="quants" t-value="variant['obj']" />
                    <t t-set="o" t-value="quants[0] if quants else False" />
                    <div
                        class="page"
                        t-att-style="not variant_first and 'page-break-before: always;' or ''"
                    >
                        <t
                            t-set="style"
                            t-value="variant.get('color') and 'color: ' + variant['color'] + ';' or ''"
                        />
                        <div
                            style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 22px; font-weight:700;"
                        >
                            <span t-att-style="style">
                                <span t-out="o.product_id.categ_id.name if o else ''" />
                                <span
                                    t-out="variant.get('extra_title') and ': ' + variant['extra_title'] or ''"
                                />
                            </span>
                        </div>
                        <table
                            class="table table-sm table-borderless"
                            style="font-size: 14px;"
                        >
                            <thead>
                                <tr
                                    style="border-bottom:1px solid #ccc;border-top:1px solid #ccc;"
                                >
                                    <th>
                                        <strong>Date</strong>
                                    </th>
                                    <th style="width: 60%;">
                                        <strong>Inventoried by:</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr
                                    style="border-bottom:1px solid #ccc;border-top:1px solid #ccc;"
                                >
                                    <td>
                                        <span
                                            t-out="docs and context_timestamp(docs[0].date).strftime('%Y-%m-%d %H:%M:%S')"
                                        />
                                    </td>
                                    <td />
                                </tr>
                            </tbody>
                        </table>
                        <table
                            class="table table-bordered"
                            style="font-size: 12px;border:1px solid #ccc;"
                        >
                            <thead>
                                <tr>
                                    <th
                                        class="text-end"
                                        style="width: 40px;font-weight:700;"
                                    >
                                        <strong>Package Qty</strong>
                                    </th>
                                    <th style="width: 70px;font-weight:700;">
                                        <strong>Internal Reference</strong>
                                    </th>
                                    <th style="font-weight:700;">
                                        <strong>Product</strong>
                                    </th>
                                    <th
                                        class="text-end"
                                        style="width: 45px;font-weight:700;"
                                    >
                                        <strong>G.F. Qty</strong>
                                    </th>
                                    <th
                                        class="text-end"
                                        style="width: 40px;font-weight:700;"
                                    >
                                        <strong>UG. Qty</strong>
                                    </th>
                                    <th
                                        class="text-end"
                                        style="width: 60px;font-weight:700;"
                                    >
                                        <strong>Total</strong>
                                    </th>
                                    <th
                                        class="text-end"
                                        style="white-space:nowrap;width:100px;font-weight:700;"
                                    >
                                        <strong>Theoretical Qty</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr
                                    t-foreach="quants.sorted(key=lambda l: l.product_name)"
                                    t-as="line"
                                >
                                    <td class="text-end">
                                        <span t-field="line.package_qty" />
                                    </td>
                                    <td>
                                        <span t-field="line.product_id.default_code" />
                                    </td>
                                    <td
                                        style="white-space: nowrap; max-width: 150px; overflow: hidden; text-overflow: ellipsis;"
                                    >
                                        <span t-field="line.product_id.name" />
                                    </td>
                                    <td class="text-end" />
                                    <td class="text-end" />
                                    <td class="text-end" />
                                    <td class="text-end">
                                        <span
                                            class="text-end"
                                            t-field="line.quantity"
                                        />
                                        <span
                                            class="text-end"
                                            t-field="line.product_uom_id"
                                            groups="uom.group_uom"
                                        />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div
                        t-if="quants.check_duplex()"
                        style="page-break-before: left; visibility: hidden;"
                    >End</div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_inventory_recurrent" model="ir.actions.report">
        <field name="name">Inventory</field>
        <field name="model">stock.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >coop_inventory_recurrent.report_inventory_new_layout</field>
        <field
            name="report_file"
        >coop_inventory_recurrent.report_inventory_new_layout</field>
        <field name="print_report_name">'Inventory - %s' % object.name</field>
        <field
            name="paperformat_id"
            ref="coop_inventory.paperformat_inventory_adjust"
        />
    </record>

    <template
        id="external_layout_standard_inventory_inherit_recurrent"
        inherit_id="coop_inventory.external_layout_standard_inventory"
        priority="99"
    >
        <xpath expr="//t[@t-call='web.address_layout']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
