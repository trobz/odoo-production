<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_inventory_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.inventory.recurrent.report.wizard.form</field>
        <field name="model">stock.inventory.recurrent.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field
                        name="inventory_ids"
                        context="{'tree_view_ref': 'stock_inventory.view_stock_inventory_list'}"
                    />
                </group>
                <footer>
                    <button
                        name="action_print"
                        type="object"
                        string="Print"
                        class="oe_highlight"
                    />
                    <button string="Discard" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_stock_inventory_report_wizard" model="ir.actions.act_window">
        <field name="name">Print Recurring Inventories</field>
        <field name="res_model">stock.inventory.recurrent.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock_inventory.model_stock_inventory" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
