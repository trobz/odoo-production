<?xml version="1.0" ?>
<odoo>
    <record id="website_menus_form_view_inherit" model="ir.ui.view">
        <field name="name">website.menu.form.inherit</field>
        <field name="model">website.menu</field>
        <field name="inherit_id" ref="website.website_menus_form_view" />
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="group_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
    <record id="website_page_form_view_inherit" model="ir.ui.view">
        <field name="name">website.page.form.inherit</field>
        <field name="model">website.page</field>
        <field name="inherit_id" ref="website.website_pages_form_view" />
        <field name="arch" type="xml">
            <field name="date_publish" position="after">
                <field name="group_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
