<odoo>
    <record model="ir.ui.view" id="view_move_form">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="capital_subscription.view_move_form" />
        <field name="arch" type="xml">
            <field name="is_capital_fundraising" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_invoice_form_inherit">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Hide classical refund button for capital subscription-->
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute
                    name="invisible"
                >move_type == 'out_refund' or state != 'posted' or is_capital_fundraising
                </attribute>
            </xpath>
            <xpath expr="//button[@name='action_reverse']" position="after">
                <button
                    name="action_reverse_capital_subscription"
                    type='object'
                    string='Refund Capital Subscription'
                    groups="coop_membership.group_refund_capital_subscription"
                    invisible="move_type == 'out_refund' or state != 'posted' or not is_capital_fundraising"
                />
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_inherit" model="ir.ui.view">
        <field name="name">view.invoice.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_partner_display_name'][1]"
                position="attributes"
            >
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_partner_display_name'][2]"
                position="attributes"
            >
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_partner_display_name'][2]"
                position="after"
            >
                <field
                    name="partner_id"
                    column_invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund', 'in_receipt')"
                    groups="base.group_user"
                    string="Vendor"
                />
                <field
                    name="partner_id"
                    column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')"
                    groups="base.group_user"
                    string="Customer"
                />
            </xpath>
        </field>
    </record>
</odoo>
