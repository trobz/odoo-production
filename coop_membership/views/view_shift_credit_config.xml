<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_shift_credit_config_form" model="ir.ui.view">
        <field name="model">shift.credit.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        type="object"
                        name="cancel"
                        string="Cancel"
                        class="btn-danger"
                        invisible="state != 'active'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group col="4">
                        <field name="credited_make_ups" readonly="state == 'cancel'" />
                        <field name="end_date" readonly="state == 'cancel'" />
                        <field name="apply_for_abcd" readonly="state == 'cancel'" />
                        <field name="apply_for_volants" readonly="state == 'cancel'" />
                    </group>
                    <notebook>
                        <page string="Templates">
                            <field
                                name="template_ids"
                                nolabel="1"
                                readonly="state == 'cancel'"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shift_credit_config_tree" model="ir.ui.view">
        <field name="model">shift.credit.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="template_ids" widget="many2many_tags" />
                <field name="credited_make_ups" />
                <field name="end_date" />
                <field name="state" />
            </list>
        </field>
    </record>
</odoo>
