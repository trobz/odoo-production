<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="register_shared_head_assets" name="Register Shared Head Assets">
        <link
            rel="stylesheet"
            href="/web/static/src/libs/fontawesome/css/font-awesome.css"
        />
        <link rel="stylesheet" href="/coop_membership/static/lib/css/main.css" />
    </template>

    <template id="register_shared_scripts" name="Register Shared Scripts">
        <script
            type="text/javascript"
            src="/coop_membership/static/lib/jquery/jquery-3.2.1.min.js"
        />
        <script type="text/javascript" src="/web/static/lib/luxon/luxon.js" />
        <script
            type="text/javascript"
            src="/coop_membership/static/src/js/discovery_meeting.esm.js"
        />
        <script src='https://www.google.com/recaptcha/api.js?hl=fr' />
    </template>

    <template id="register_event_selector" name="Register Event Selector">
        <div class="wrap-input100 input_radio validate-input bg1 dropDownSelect2">
            <span
                class="label-input100 long-text"
            >Je m'inscris à la réunion d'accueil du :</span>
            <br />
            <span
                style="color: #f04a4f"
                class="validate-option-event"
            >Veuillez renseigner votre
                réunion
            </span>
            <div>
                <t t-foreach="datas" t-as="data">
                    <input
                        type="radio"
                        name="select_event"
                        class="validate-input-option validate-input"
                        t-att-value="data[0]"
                    >
                        <t t-esc="data[2][0:10]" />
                        à
                        <t t-esc="data[2][11:16] or False" />
                        <t t-if="data[1]">-
                            <t t-esc="data[1]" />
                        </t>
                    </input>
                    <br />
                </t>
            </div>
        </div>
    </template>

    <template id="register_recaptcha" name="Register Recaptcha">
        <div
            class="g-recaptcha"
            t-att-data-sitekey="captcha_site_key"
            data-validate="Veuillez cliquer sur la case reCAPTCHA"
        />
        <div
            style="color: #f04a4f"
            class="validate-option-event"
        >Veuillez cliquer sur la case
            reCAPTCHA
        </div>
    </template>

    <template id="register_submit_button" name="Register Submit Button">
        <div class="container-contact100-form-btn">
            <button class="contact100-form-btn">
                <span>
                    Envoyer
                    <i class="fa fa-long-arrow-right m-l-7" aria-hidden="true" />
                </span>
            </button>
        </div>
    </template>

    <template id="register_identity_fields" name="Register Identity Fields">
        <div
            class="wrap-input100 validate-input bg1"
            data-validate="Veuillez renseigner votre adresse électronique (e@a.x)"
        >
            <span class="label-input100">Courriel</span>
            <span class="star_style">*</span>
            <input
                class="input100"
                type="text"
                name="email"
                t-att-value="email"
                placeholder="Veuillez renseigner votre adresse électronique "
            />
        </div>
        <div
            class="wrap-input100 validate-input bg1"
            data-validate="Veuillez renseigner votre nom"
        >
            <span class="label-input100">Nom</span>
            <span class="star_style">*</span>
            <input
                class="input100"
                type="text"
                name="name"
                t-att-value="name"
                placeholder="Veuillez renseigner votre nom"
            />
        </div>
        <div
            class="wrap-input100 validate-input bg1"
            data-validate="Veuillez renseigner votre prénom"
        >
            <span class="label-input100">Prénom</span>
            <span class="star_style">*</span>
            <input
                class="input100"
                type="text"
                name="first_name"
                t-att-value="first_name"
                placeholder="Veuillez renseigner votre prénom"
            />
        </div>
        <div class="wrap-input100 bg1 input_radio">
            <span class="label-input100">Sexe</span>
            <br />
            <input
                type="radio"
                name="gender"
                value="male"
                t-att-checked="gender == 'male' and 'checked' or None"
            > Homme</input>
            <br />
            <input
                type="radio"
                name="gender"
                value="female"
                t-att-checked="gender == 'female' and 'checked' or None"
            > Femme</input>
            <br />
            <input
                type="radio"
                name="gender"
                value="other"
                t-att-checked="gender == 'other' and 'checked' or None"
            > Autre</input>
            <br />
        </div>
        <div class="wrap-input100 bg1">
            <span class="label-input100 long-text">Date de naissance</span>
            <input
                class="dob input100 datetimepicker-input"
                type="text"
                name="dob"
                t-att-value="dob"
                placeholder="Veuillez renseigner votre date de naissance"
                id="dob_datepicker"
            />
        </div>
        <div class="wrap-input100 bg1">
            <span class="label-input100">Mobile</span>
            <input
                class="input100"
                type="text"
                name="mobile"
                t-att-value="mobile"
                placeholder="Veuillez renseigner votre numéro mobile"
            />
        </div>
        <div class="wrap-input100 bg1">
            <span class="label-input100">Téléphone</span>
            <input
                class="input100"
                type="text"
                name="phone"
                t-att-value="phone"
                placeholder="Veuillez renseigner votre numéro téléphone"
            />
        </div>
        <div class="wrap-input100 bg1">
            <span class="label-input100">Adresse</span>
            <input
                class="input100"
                type="text"
                name="street1"
                t-att-value="street1"
                placeholder="Veuillez renseigner votre adresse"
            />
        </div>
        <div class="wrap-input100 bg1">
            <span class="label-input100 long-text">Complément d'adresse</span>
            <input
                class="input100"
                type="text"
                name="street2"
                t-att-value="street2"
                placeholder="Veuillez renseigner votre complément d'adresse"
            />
        </div>
        <div class="wrap-input100 bg1">
            <span class="label-input100">Ville</span>
            <input
                class="input100"
                type="text"
                name="city"
                t-att-value="city"
                placeholder="Veuillez renseigner votre ville"
            />
        </div>
        <div class="wrap-input100 bg1">
            <span class="label-input100 long-text">Code postal</span>
            <input
                class="input100"
                type="text"
                name="zipcode"
                t-att-value="zipcode"
                placeholder="Veuillez renseigner votre code postal"
            />
        </div>
    </template>

    <template id="register_form" name="Register Form">
        <html>
            <head id="website_register_header" name="website_register_header">
                <title>Inscription - Réunions d'accueil</title>
                <t t-call="coop_membership.register_shared_head_assets" />
            </head>
            <body>
                <div class="container-contact100">
                    <div class="wrap-contact100">
                        <form
                            action="/web/membership/register/submit"
                            method="POST"
                            class="contact100-form validate-form"
                        >
                            <span class="contact100-form-title">
                                Inscription - Réunions d'accueil
                            </span>
                            <t t-out="description" />
                            <t t-out="notice" />
                            <!-- <span class="first-text-block">
                                Rejoindre la coopérative passe exclusivement par votre présence à une réunion d’accueil. Ces réunions étant importantes, et le nombre de places limité pour chacune d'entre elles, <strong>merci de ne vous inscrire que dans le cas où vous êtes sûr d'être disponible</strong>, et ce sur toute la durée de la réunion.
                            </span>
                            <span class="first-text-block">
                                Rappel : pour pouvoir souscrire à l’issue de la réunion d’accueil, vous devez <strong>obligatoirement vous munir de :</strong>
                            </span>
                            <span class="first-text-block">
                                <ul>
                                    <li>1. votre carnet de chèque ou votre carte bancaire</li>
                                    <li>2. une pièce d’identité</li>
                                    <li>3. un justificatif datant de moins de 3 mois pour une souscription réduite : <a href="https://cooplalouve.fr/minimas-sociaux" class="link_style">https://cooplalouve.fr/minimas-sociaux.</a></li>
                                </ul>
                            </span>

                            <span class="first-text-block">De nouvelles dates sont ajoutées régulièrement.</span>
                            <em class="first-text-block final-text-block">Si vous devez contactez les organisateurs des réunions d’accueil, merci d’utiliser cette adresse : reunion.accueil@cooplalouve.fr</em> -->
                            <t t-set="email" t-value="False" />
                            <t t-set="name" t-value="False" />
                            <t t-set="first_name" t-value="False" />
                            <t t-set="gender" t-value="False" />
                            <t t-set="dob" t-value="False" />
                            <t t-set="mobile" t-value="False" />
                            <t t-set="phone" t-value="False" />
                            <t t-set="street1" t-value="False" />
                            <t t-set="street2" t-value="False" />
                            <t t-set="city" t-value="False" />
                            <t t-set="zipcode" t-value="False" />
                            <t t-call="coop_membership.register_identity_fields" />
                            <!-- <div class="wrap-input100 bg1 input_radio" >
                                <span class="label-input100 long-text">Titulaire d'un justificatif minima social</span>
                                <br />
                                <input  type="radio" name="social_registration" value="yes">  Oui </input><br />
                                <input  type="radio" checked="checked" name="social_registration" value="no">  Non </input><br />
                            </div> -->

                            <t t-call="coop_membership.register_event_selector" />
                            <t t-call="coop_membership.register_recaptcha" />
                            <t t-call="coop_membership.register_submit_button" />
                        </form>
                    </div>
                </div>
                <t t-call="coop_membership.register_shared_scripts" />
            </body>
        </html>
    </template>

    <template id="register_submit_form_success" name="Register Submit Form">
        <html>
            <head id="website_register_header" name="website_register_header">
                <title>Inscription - Réunions d'accueil</title>
                <link
                    rel="stylesheet"
                    href="/coop_membership/static/lib/css/main.css"
                />
            </head>
            <body>
                <div class="container-contact100">
                    <div class="wrap-contact100">
                        <span class="contact100-form-title">
                            Inscription enregistrée. Vous allez recevoir un email de confirmation.
                        </span>
                        <div
                            class="container-contact100-form-btn"
                            style="margin: auto; width: 12%;"
                        >
                            <a t-att-href="website">
                                <button class="contact100-form-btn">
                                    <span>
                                        OK
                                        <i
                                        class="fa fa-long-arrow-right m-l-7"
                                        aria-hidden="true"
                                    />
                                    </span>
                                </button>
                            </a>
                        </div>
                    </div>
                </div>
            </body>
        </html>
    </template>

