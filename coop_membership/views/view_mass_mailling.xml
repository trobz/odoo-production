<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="mailing_contact_view_tree_inherit">
        <field name="name">mailing.contact.tree</field>
        <field name="model">mailing.contact</field>
        <field name="inherit_id" ref="mass_mailing.mailing_contact_view_tree" />
        <field name="arch" type="xml">
            <field name="email" position="before">
                <field name="name" position="move" />
            </field>
            <field name="email" position="before">
                <field name="partner_id" context="{'only_show_barcode_base': True}" />
            </field>
        </field>
    </record>
    <record
        model="ir.actions.act_window"
        id="mass_mailing.action_view_mass_mailing_contacts"
    >
        <field name="name">Mailing List Subscribers</field>
        <field name="res_model">mailing.contact</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{'only_show_barcode_base': True}</field>
    </record>
</odoo>
