<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="priority" eval="65" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Membership"
                    data-string="Membership"
                    name="coop_membership"
                    groups="coop_shift.group_shift_manager"
                >
                    <block
                        title="Shifts"
                        name="shift_settings"
                        groups="base.group_system"
                    >
                        <setting
                            id="shift_cycles"
                            string="Shift Cycles"
                            help="Control how weeks are named, and your cycles. Changes on this settings could have undesireable results. Do it with caution."
                        >
                            <div class="content-group">
                                <div class="mt16">
                                    <label
                                        for="shift_weeks_per_cycle"
                                        class="o_light_label"
                                    />
                                    <field
                                        name="shift_weeks_per_cycle"
                                        class="oe_inline"
                                    />
                                </div>
                                <div class="mt8">
                                    <label
                                        for="shift_week_a_date"
                                        class="o_light_label"
                                    />
                                    <field name="shift_week_a_date" class="oe_inline" />
                                </div>
                                <div class="mt8">
                                    <button
                                        type="object"
                                        name="action_recompute_shift_weeks"
                                        string="Recompute shifts' week names"
                                        confirm="This will recompute all week numbers and names based on your new configuration. It will affect all existing shifts (past and future). Are you sure you want to continue?"
                                        class="oe_link"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting id="shift_state_delay_duration_setting">
                            <label for="shift_state_delay_duration" />
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="shift_state_delay_duration" /> days.
                                </div>
                            </div>
                        </setting>
                        <setting id="shift_leave_remind_days_setting">
                            <label for="shift_leave_remind_days" />
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="shift_leave_remind_days" /> days.
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Membership" name="membership_settings">
                        <setting id="associated_people_available_setting">
                            <field
                                name="associated_people_available"
                                widget="radio"
                                class="o_light_label"
                            />
                            <div
                                class="mt16"
                                invisible="associated_people_available == 'unlimited'"
                                required="associated_people_available == 'limited'"
                            >
                                <label
                                    for="max_nb_associated_people"
                                    class="o_light_label"
                                />
                                <field
                                    name="max_nb_associated_people"
                                    class="oe_inline"
                                />
                            </div>
                        </setting>
                        <setting id="contact_us_messages_setting">
                            <field name="contact_us_messages" class="oe_inline" />
                        </setting>
                    </block>

                    <block
                        title="FTOP Registration Limits"
                        name="ftop_registration_limits"
                    >
                        <setting id="max_registrations_per_day_setting">
                            <field name="max_registrations_per_day" />
                        </setting>
                        <setting id="max_registration_per_period_setting">
                            <field name="max_registration_per_period" />
                        </setting>
                        <setting id="number_of_days_in_period_setting">
                            <field name="number_of_days_in_period" />
                        </setting>
                    </block>

                    <block
                        title="Maximum Active Days"
                        name="maximum_active_days_settings"
                    >
                        <setting id="maximum_active_days_setting">
                            <field name="maximum_active_days" />
                        </setting>
                    </block>

                    <block title="Message Settings" name="message_settings">
                        <setting id="company_name_setting">
                            <field name="company_name" class="oe_inline" />
                        </setting>
                        <setting id="email_meeting_contact_setting">
                            <field name="email_meeting_contact" class="oe_inline" />
                        </setting>
                        <setting
                            id="members_office_open_hours_setting"
                            help="Configure Members Office Open Hours Here. This text will appear in email templates."
                        >
                            <field name="members_office_open_hours" class="oe_inline" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_coop_membership_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="res_config_settings_view_form" />
        <field name="target">inline</field>
        <field name="context">{'module' : 'coop_membership', 'bin_size': False}</field>
    </record>
    <menuitem
        id="menu_shift_type_setting"
        name="Settings"
        action="action_coop_membership_config_settings"
        parent="coop_shift.menu_shift_configuration"
        sequence="0"
        groups="base.group_system"
    />
</odoo>
