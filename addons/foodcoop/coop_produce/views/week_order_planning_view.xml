<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_coop_produce_order_week_planning_tree" model="ir.ui.view">
        <field name="name">order.week.planning.tree</field>
        <field name="model">order.week.planning</field>
        <field name="priority" eval="18" />
        <field name="arch" type="xml">
            <list string="Order Scheduling" default_order='year desc,week_number desc'>
                <field name="date" />
                <field name="state" />
                <field name="week_number" />
            </list>
        </field>
    </record>

    <record id="view_coop_produce_order_week_planning_filter" model="ir.ui.view">
        <field name="name">order.week.planning.filter</field>
        <field name="model">order.week.planning</field>
        <field name="arch" type="xml">
            <search string="Search Inventory">
                <field name="date" string="date" />
                <field name="week_number" string="Week Number" />
                <group expand="0" string="Group By">
                    <filter
                        string="Date"
                        name="date"
                        domain="[]"
                        context="{'group_by':'date'}"
                    />
                    <filter
                        string="Week Number"
                        name="week_number"
                        domain="[]"
                        context="{'group_by':'week_number'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record
        id="view_coop_produce_order_week_planning_interface_form"
        model="ir.ui.view"
    >
        <field name="name">order.week.planning.form</field>
        <field name="model">order.week.planning</field>
        <field name="priority" eval="18" />
        <field name="arch" type="xml">
            <form string="Order Scheduling">
                <header>
                    <button
                        name="action_close_week"
                        string="Close Week"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_generate_next_week"
                        string="Next week"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        name="action_reset"
                        string="Reset"
                        type="object"
                        class="btn btn-danger"
                        invisible="state != 'draft'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,done"
                    />
                </header>
                <sheet class="container">
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                        >
                            <field
                                string="Week orders"
                                name="week_total_orders"
                                widget="statinfo"
                            />
                        </button>
                        <button
                            name="action_view_picking"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                        >
                            <field
                                string="Week receptions"
                                name="week_total_receptions"
                                widget="statinfo"
                            />
                        </button>
                        <button
                            name="action_other_weeks"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            string="Previous weeks"
                        />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group name="date_info">
                        <field name="date" />
                        <field name="week_number" string="N° Week" />
                        <field name="hide_initialisation" />
                    </group>
                    <group invisible="hide_initialisation or state == 'done'">
                        <group>
                            <field
                                name="categ_ids"
                                widget="many2many_tags"
                                string="Product Categories"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group>
                            <button
                                name="action_add_products"
                                string="Add Products"
                                type="object"
                                class="oe_highlight"
                            />
                        </group>
                        <group>
                            <field
                                name="supplier_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group>
                            <button
                                name="action_update_start_inventory"
                                string="Update Stock Inventory"
                                type="object"
                                class="oe_highlight"
                            />
                        </group>
                    </group>
                    <separator string="Order Calendar" />
                    <div class="row mb-3">
                        <div class="col-sm">
                            <h4>==></h4>
                        </div>
                        <div class="col-sm">
                            <button
                                name="create_purchase_orders"
                                string="Mon."
                                type="object"
                                class="oe_highlight oe_inline"
                                context="{'day_number':1}"
                                help="Create purchase orders for Monday"
                            />
                        </div>
                        <div class="col-sm">
                            <button
                                name="create_purchase_orders"
                                string="Tue."
                                type="object"
                                class="oe_highlight oe_inline"
                                context="{'day_number':2}"
                                help="Create purchase orders for Tuesday"
                            />
                        </div>
                        <div class="col-sm">
                            <button
                                name="create_purchase_orders"
                                string="Wed."
                                type="object"
                                class="oe_highlight oe_inline"
                                context="{'day_number':3}"
                                help="Create purchase orders for Wednesday"
                            />
                        </div>
                        <div class="col-sm">
                            <button
                                name="create_purchase_orders"
                                string="Thu."
                                type="object"
                                class="oe_highlight oe_inline"
                                context="{'day_number':4}"
                                help="Create purchase orders for Thursday"
                            />
                        </div>
                        <div class="col-sm">
                            <button
                                name="create_purchase_orders"
                                string="Fri."
                                type="object"
                                class="oe_highlight oe_inline"
                                context="{'day_number':5}"
                                help="Create purchase orders for Friday"
                            />
                        </div>
                        <div class="col-sm">
                            <button
                                name="create_purchase_orders"
                                string="Sat."
                                type="object"
                                class="oe_highlight oe_inline"
                                context="{'day_number':6}"
                                help="Create purchase orders for Saturday"
                            />
                        </div>
                        <div class="w-100 mt-3" />
                        <div class="col-sm">
                            <h5>Total Ordered / To Order</h5>
                        </div>
                        <div class="col-sm">
                            <field
                                name="monday_ordered_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="tuesday_ordered_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="wednesday_ordered_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="thirsday_ordered_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="friday_ordered_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="saturday_ordered_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="w-100 mt-3" />
                        <div class="col-sm">
                            <h5>Total Received / To Receive</h5>
                        </div>
                        <div class="col-sm">
                            <field
                                name="monday_received_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="tuesday_received_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="wednesday_received_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="thirsday_received_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="friday_received_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="saturday_received_qty"
                                nolabel="1"
                                readonly="True"
                            />
                        </div>
                        <div class="w-100 mt-3" />
                        <div class="col-sm">
                            <h5>Enable/Disable</h5>
                        </div>
                        <div class="col-sm">
                            <field
                                name="toggle_monday_qty"
                                nolabel="1"
                                widget="boolean_toggle"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="toggle_tuesday_qty"
                                nolabel="1"
                                widget="boolean_toggle"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="toggle_wednesday_qty"
                                nolabel="1"
                                widget="boolean_toggle"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="toggle_thursday_qty"
                                nolabel="1"
                                widget="boolean_toggle"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="toggle_friday_qty"
                                nolabel="1"
                                widget="boolean_toggle"
                            />
                        </div>
                        <div class="col-sm">
                            <field
                                name="toggle_saturday_qty"
                                nolabel="1"
                                widget="boolean_toggle"
                            />
                        </div>
                        <div class="w-100 mt-3" />
                        <div class="col-4">
                            <group>
                                <field name="toggle_product" widget="boolean_toggle" />
                            </group>
                        </div>
                        <div class="col-4">
                            <group>
                                <field
                                    name="toggle_end_inv_qty"
                                    widget="boolean_toggle"
                                />
                            </group>
                        </div>
                        <div class="col-4">
                            <group>
                                <field name="toggle_loss_qty" widget="boolean_toggle" />
                            </group>
                        </div>
                    </div>
                    <separator string="Order Planning Details" />
                    <field
                        name="line_ids"
                        context="
                            {'default_order_week_planning_id':id, 'order_planning_context':True,'partner_display_only_ref':True, 'form_view_ref': False,
                            'toggle_monday_qty': toggle_monday_qty, 'toggle_tuesday_qty': toggle_tuesday_qty, 'toggle_wednesday_qty': toggle_wednesday_qty,
                            'toggle_thursday_qty': toggle_thursday_qty, 'toggle_friday_qty': toggle_friday_qty, 'toggle_saturday_qty': toggle_saturday_qty,
                            'toggle_product': toggle_product, 'toggle_end_inv_qty': toggle_end_inv_qty, 'toggle_loss_qty': toggle_loss_qty
                            }"
                    >
                        <list
                            string="Order Planning Details"
                            editable="bottom"
                            class="week_planning"
                        >
                            <button
                                name="action_product_history_view"
                                title="History"
                                icon="fa-sticky-note-o"
                                type="object"
                            />
                            <field name="product_id" readonly="not toggle_product" />
                            <field name="default_packaging" readonly="True" />
                            <field name="supplier_packaging" class="auto_select" />
                            <button
                                name="action_update_supplier_packaging"
                                title="Update Supplier Packaging"
                                icon="fa-check"
                                type="object"
                            />
                            <field name="supplier_id" required="True" />
                            <field
                                name="price_unit"
                                string="Price U"
                                class="auto_select"
                            />
                            <button
                                name="action_update_unit_price"
                                title="Update Price Unit"
                                icon="fa-check"
                                type="object"
                            />
                            <field name="price_policy" string="P. Policy" />
                            <button
                                name="action_update_price_policy"
                                title="Update Price Policy"
                                icon="fa-check"
                                type="object"
                            />
                            <field name="sold_w_2_qty" />
                            <field name="sold_w_1_qty" />
                            <field name="start_inv" readonly="1" />
                            <field
                                name="monday_qty"
                                string="Mon."
                                readonly="not toggle_monday_qty"
                                class="auto_select"
                            />
                            <field
                                name="tuesday_qty"
                                string="Tue."
                                readonly="not toggle_tuesday_qty"
                                class="auto_select"
                            />
                            <field
                                name="wednesday_qty"
                                string="Wed."
                                readonly="not toggle_wednesday_qty"
                                class="auto_select"
                            />
                            <field
                                name="medium_inventory_qty"
                                string="Med."
                                class="auto_select"
                            />
                            <field
                                name="thirsday_qty"
                                string="Thi."
                                readonly="not toggle_thursday_qty"
                                class="auto_select"
                            />
                            <field
                                name="friday_qty"
                                string="Fri."
                                readonly="not toggle_friday_qty"
                                class="auto_select"
                            />
                            <field
                                name="saturday_qty"
                                string="Sat."
                                readonly="not toggle_saturday_qty"
                                class="auto_select"
                            />
                            <field name="total_qty" />
                            <field
                                name="end_inv_qty"
                                readonly="not toggle_end_inv_qty"
                                class="auto_select"
                            />
                            <field
                                name="loss_qty"
                                readonly="not toggle_loss_qty"
                                class="auto_select"
                            />
                            <field name="sold_qty" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record
        id="view_coop_produce_order_week_planning_action"
        model="ir.actions.act_window"
    >
        <field name="name">Planification Of F/V</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">order.week.planning</field>
        <field name="view_mode">list,form</field>
    </record>

    <record
        id="action_coop_produce_order_week_planning_tree"
        model="ir.actions.act_window.view"
    >
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_coop_produce_order_week_planning_tree" />
        <field
            name="act_window_id"
            ref="view_coop_produce_order_week_planning_action"
        />
    </record>

    <record
        id="action_coop_produce_order_week_planning_form"
        model="ir.actions.act_window.view"
    >
        <field name="view_mode">form</field>
        <field
            name="view_id"
            ref="view_coop_produce_order_week_planning_interface_form"
        />
        <field
            name="act_window_id"
            ref="view_coop_produce_order_week_planning_action"
        />
    </record>

    <menuitem
        id="menu_planification_fruits_vegetables"
        name="Planification Des F&amp;L"
        parent="stock.menu_stock_inventory_control"
        groups="stock.group_stock_manager"
        sequence="61"
        action="view_coop_produce_order_week_planning_action"
    />

    <record id="view_order_week_planning_line_tree" model="ir.ui.view">
        <field name="name">order.week.planning.line.tree</field>
        <field name="model">order.week.planning.line</field>
        <field name="priority" eval="18" />
        <field name="arch" type="xml">
            <list
                string="Product history"
                default_order='week_year desc,week_number desc, product_name'
            >
                <field name="week_year" />
                <field name="week_number" />
                <field name="product_id" />
                <field name="default_packaging" />
                <field name="supplier_packaging" />
                <field name="supplier_id" string="Supplier" />
                <field name="price_unit" string="Price U" />
                <field name="start_inv" readonly="1" />
                <field name="monday_qty" string="Mon." />
                <field name="tuesday_qty" string="Tue." />
                <field name="wednesday_qty" string="Wed." />
                <field name="medium_inventory_qty" string="Med." />
                <field name="thirsday_qty" string="Thi." />
                <field name="friday_qty" string="Fri." />
                <field name="saturday_qty" string="Sat." />
                <field name="total_qty" />
                <field name="end_inv_qty" />
                <field name="loss_qty" />
                <field name="sold_qty" />
            </list>
        </field>
    </record>

    <record id="view_order_week_planning_line_search" model="ir.ui.view">
        <field name="name">order.week.planning.line.search</field>
        <field name="model">order.week.planning.line</field>
        <field name="priority" eval="18" />
        <field name="arch" type="xml">
            <search string="Product history">
                <field name="week_year" />
                <field name="week_number" />
                <field name="product_id" />
                <field name="supplier_id" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_year"
                        string="Year"
                        domain="[]"
                        context="{'group_by':'week_year'}"
                    />
                    <filter
                        name="group_by_week_number"
                        string="Week"
                        domain="[]"
                        context="{'group_by':'week_number'}"
                    />
                    <filter
                        name="group_by_product_id"
                        string="Product"
                        domain="[]"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        name="group_by_supplier_id"
                        string="Supplier"
                        domain="[]"
                        context="{'group_by':'supplier_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
