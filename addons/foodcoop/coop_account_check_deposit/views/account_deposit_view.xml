<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_check_deposit_view_form_inherit" model="ir.ui.view">
        <field name="model">account.check.deposit</field>
        <field
            name="inherit_id"
            ref="account_check_deposit.account_check_deposit_view_form"
        />
        <field name="arch" type="xml">
            <field name="check_payment_ids" position="attributes">
                <attribute
                    name="context"
                >{'currency': currency_id, 'journal_id': journal_id, 'change_check_holder_name': True}</attribute>
                <attribute name="options">{'reload_on_button': true}</attribute>
            </field>
            <xpath expr="//list" position="attributes">
                <attribute name="delete">false</attribute>
            </xpath>
            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="check_holder_name" />
            </xpath>
        </field>
    </record>
</odoo>
