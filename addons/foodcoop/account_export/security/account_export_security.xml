<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="group_account_export" model="res.groups">
        <field name="name">Account Export</field>
        <field name="users" eval="[Command.link(ref('base.user_root'))]" />
        <field
            name="menu_access"
            eval="[
            Command.link(ref('account.menu_finance')),
            Command.link(ref('menu_account_exports')),
            Command.link(ref('menu_account_export_moves')),
            Command.link(ref('menu_account_export_config')),
            Command.link(ref('menu_move_to_export'))
        ]"
        />
    </record>
    <record id="rule_account_export_multicompany" model="ir.rule">
        <field name="name">Account Export Multicompany</field>
        <field name="model_id" ref="model_account_export" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
