<odoo>
    <!-- Root User - Badge Reader Manager -->
    <record model="res.users" id="base.user_root">
        <field name="barcode">123</field>
    </record>

    <!-- Demo User - Badge Reader User -->
    <record model="res.users" id="base.user_demo">
        <field name="barcode">456</field>
    </record>

    <!-- Demo User - Time Clock Operator -->
    <record
        model="res.users"
        id="demo_user_time_clock"
        context="{'no_reset_password': True}"
    >
        <field name="name">Time Clock Operator</field>
        <field name="login">time_clock_demo</field>
        <field name="password">time_clock_demo</field>
        <field name="barcode">789</field>
        <field name="partner_id" ref="demo_partner_time_clock" />
    </record>

    <!-- Demo User - Alert Manager -->
    <record
        model="res.users"
        id="demo_user_alert_manager"
        context="{'no_reset_password': True}"
    >
        <field name="name">Alert Manager</field>
        <field name="login">alert_manager_demo</field>
        <field name="password">alert_manager_demo</field>
        <field name="barcode">101112</field>
        <field name="partner_id" ref="demo_partner_alert_manager" />
    </record>
</odoo>
