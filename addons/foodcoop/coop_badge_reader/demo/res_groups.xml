<odoo>
    <!-- Manager Group - Full access to badge reader -->
    <record model="res.groups" id="group_manager">
        <field name="users" eval="[Command.set([ref('base.user_root')])]" />
    </record>

    <!-- User Group - Can view move logs -->
    <record model="res.groups" id="group_user">
        <field name="users" eval="[Command.set([ref('base.user_demo')])]" />
    </record>

    <!-- Time Clock Group - Can use badge reader app -->
    <record model="res.groups" id="group_time_clock">
        <field name="users" eval="[Command.set([ref('demo_user_time_clock')])]" />
    </record>

    <!-- Alert Entry Manager Group - Can manage alerts -->
    <record model="res.groups" id="group_alert_entry_manager">
        <field
            name="users"
            eval="[Command.set([ref('base.user_root'), ref('demo_user_alert_manager')])]"
        />
    </record>

    <!-- Sale Manager Group -->
    <record model="res.groups" id="sales_team.group_sale_manager">
        <field name="users" eval="[Command.set([ref('base.user_root')])]" />
    </record>
</odoo>
