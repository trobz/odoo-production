<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="coop_badge_reader.BackButton">
        <div class="mb-3">
            <button
                t-on-click="() => this.props.onClickBack()"
                class="btn btn-secondary d-flex flex-row align-items-center"
                t-if="this.props.displayBackButton"
            >
                <i
                class="oi oi-chevron-left me-1"
                role="img"
                aria-label="Go back"
                title="Go back"
            />
                Back
            </button>
        </div>
    </t>

</templates>
