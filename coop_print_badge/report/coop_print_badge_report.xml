<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_printbadge" model="ir.actions.report">
        <field name="name">Print Badge</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coop_print_badge.report_printbadge</field>
        <field
            name="groups_id"
            eval="[
            (4, ref('coop_membership.group_membership_access_user')),
            (4, ref('coop_membership.group_membership_see_associated_people'))
        ]"
        />
        <field name="attachment_use" eval="False" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="paperformat_id" ref="coop_print_badge.paperformat_CEI_7810" />
    </record>
</odoo>
