<odoo>
    <record id="action_product_coefficient" model="ir.actions.act_window">
        <field name="name">Products Coefficients</field>
        <field name="res_model">product.coefficient</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_product_template_coefficient_tree" model="ir.actions.act_window">
        <field name="name">Products (Coefficients View)</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_template_coefficient_tree" />
    </record>

    <record id="action_product_use_theoritical_price" model="ir.actions.act_window">
        <field name="name">Use Theoritical Prices</field>
        <field name="res_model">wizard.use.theoritical.price</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
