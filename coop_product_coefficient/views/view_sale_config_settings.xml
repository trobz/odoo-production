<?xml version="1.0" ?>
<odoo>
    <record id="view_sales_config_inherit" model="ir.ui.view">
        <field name="name">view.sales.config.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Product Coefficients">
                    <setting string="Update Base Price Automatically">
                        <field name="auto_update_base_price" />
                    </setting>
                    <setting string="Update Theoretical Cost Automatically">
                        <field name="auto_update_theorical_cost" />
                    </setting>
                    <setting string="Update Theoretical Price Automatically">
                        <field name="auto_update_theorical_price" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
