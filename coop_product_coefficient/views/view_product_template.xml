<odoo>
    <record id="view_product_template_coefficient_tree" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list editable="bottom" class="o_coeff_list_view">
                <field name="name" readonly="1" class="o_coeff_name_cell" />
                <field name="base_price" />
                <field name="alternative_base_price_sale" />
                <field name="alternative_base_price_standard" />
                <field name="coeff1_id" />
                <field name="incl_in_standard_price_1" />
                <field name="coeff2_id" />
                <field name="incl_in_standard_price_2" />
                <field name="coeff3_id" />
                <field name="incl_in_standard_price_3" />
                <field name="coeff4_id" />
                <field name="incl_in_standard_price_4" />
                <field name="coeff5_id" />
                <field name="incl_in_standard_price_5" />
                <field name="coeff6_id" />
                <field name="incl_in_standard_price_6" />
                <field name="coeff7_id" />
                <field name="incl_in_standard_price_7" />
                <field name="coeff8_id" />
                <field name="incl_in_standard_price_8" />
                <field name="coeff9_id" />
                <field name="incl_in_standard_price_9" />
                <field name="theoritical_price" />
                <field name="list_price" />
                <button
                    name="use_theoritical_price"
                    type="object"
                    title="Use Theoritical Price"
                    invisible="not has_theoritical_price_different"
                    icon="fa-check-circle"
                />
            </list>
        </field>
    </record>
    <record id="view_product_template_tree" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="theoritical_price" />
            </field>
        </field>
    </record>
    <record id="view_product_template_search" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <filter name="inactive" position="after">
                <filter
                    string="Has Theoritical Price Different"
                    name="filter_has_theoritical_price_different"
                    domain="[('has_theoritical_price_different', '=', True)]"
                />
            </filter>
            <field name="attribute_line_ids" position="after">
                <field name="categ_id" />
            </field>
        </field>
    </record>
    <record id="view_product_template_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <button name="action_open_documents" position="before">
                <button
                    name="recompute_base_price"
                    type="object"
                    icon="fa-calculator"
                    class="oe_stat_button"
                    string="Recompute Base price"
                    groups="sales_team.group_sale_manager"
                />
                <button
                    name="use_theoritical_cost"
                    type="object"
                    icon="fa-rotate-left"
                    class="oe_stat_button"
                    string="Use Theoritical Cost"
                    invisible="not has_theoritical_cost_different"
                    groups="sales_team.group_sale_manager"
                />
                <button
                    name="use_theoritical_price"
                    type="object"
                    icon="fa-rotate-left"
                    class="oe_stat_button"
                    string="Use Theoritical Price"
                    invisible="not has_theoritical_price_different"
                    groups="sales_team.group_sale_manager"
                />
            </button>
            <xpath expr="//notebook" position="inside">
                <page
                    name="coefficient"
                    string="Coefficients"
                    groups="sales_team.group_sale_manager"
                >
                    <group>
                        <group>
                            <group>
                                <field name="base_price" />
                                <field name="alternative_base_price_sale" />
                                <field name="alternative_base_price_standard" />
                            </group>
                            <group />
                        </group>
                        <group colspan="4" col="6">
                            <table class="coeff_table">
                                <thead>
                                    <tr>
                                        <th
                                            class="coeff_title"
                                            colspan="2"
                                        >Coefficients</th>
                                        <th class="coeff_title">Sale Price</th>
                                        <th class="coeff_title">Include in Cost</th>
                                        <th class="coeff_title">Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 1</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff1_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff1_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_1"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff1_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 2</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff2_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff2_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_2"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff2_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 3</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff3_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff3_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_3"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff3_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 4</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff4_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff4_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_4"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff4_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 5</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff5_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff5_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_5"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff5_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 6</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff6_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff6_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_6"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff6_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 7</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff7_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff7_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_7"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff7_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 8</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff8_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff8_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_8"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff8_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                    <tr class="coeff_row">
                                        <td class="coeff_cell_label">Coefficient 9</td>
                                        <td class="coeff_cell_field">
                                            <field name="coeff9_id" />
                                        </td>
                                        <td class="coeff_cell_price">
                                            <field name="coeff9_inter" nolabel="1" />
                                        </td>
                                        <td class="coeff_cell_checkbox">
                                            <field
                                                name="incl_in_standard_price_9"
                                                nolabel="1"
                                            />
                                        </td>
                                        <td class="coeff_cell_cost">
                                            <field name="coeff9_inter_sp" nolabel="1" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </group>
                        <group>
                            <table class="coeff_summary_table">
                                <tr>
                                    <th>Theoritical Price VAT Incl.</th>
                                    <td>
                                        <field
                                            name="theoritical_price"
                                            class="coeff_theorical_price_field"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <th>Has Theoritical Price Different</th>
                                    <td>
                                        <field name="has_theoritical_price_different" />
                                    </td>
                                </tr>
                                <tr>
                                    <th>Has Theoritical Cost Different</th>
                                    <td>
                                        <field name="has_theoritical_cost_different" />
                                    </td>
                                </tr>
                            </table>
                            <group />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field
                    name="theoritical_warning_label"
                    nolabel="1"
                    colspan="2"
                    style="color: #856404;background-color: #fff3cd;border-color: #ffeeba;"
                />
            </xpath>
        </field>
    </record>
</odoo>
