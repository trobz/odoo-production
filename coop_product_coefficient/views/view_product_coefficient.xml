<odoo>
    <record id="view_product_coefficient_search" model="ir.ui.view">
        <field name="model">product.coefficient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="operation_type" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
            </search>
        </field>
    </record>

    <record id="view_product_coefficient_tree" model="ir.ui.view">
        <field name="model">product.coefficient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="operation_type" />
                <field name="value" />
                <field name="note" />
            </list>
        </field>
    </record>

    <record id="view_product_coefficient_form" model="ir.ui.view">
        <field name="model">product.coefficient</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="first" string="Settings">
                        <field name="operation_type" />
                        <field name="value" />
                        <field name="note" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
