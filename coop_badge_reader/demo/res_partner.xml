<odoo>
    <!-- Root Partner - Up to Date -->
    <record model="res.partner" id="base.partner_root">
        <field name="customer" eval="True" />
        <field name="cooperative_state">up_to_date</field>
    </record>

    <!-- Demo Partner - Vacation -->
    <record model="res.partner" id="base.partner_demo">
        <field name="customer" eval="True" />
        <field name="cooperative_state">vacation</field>
    </record>

    <!-- Demo Partner - Alert State -->
    <record model="res.partner" id="demo_partner_alert_1">
        <field name="name">Alert Member Demo</field>
        <field name="customer" eval="True" />
        <field name="cooperative_state">alert</field>
        <field name="shift_type">standard</field>
        <field name="barcode_base">1111</field>
    </record>

