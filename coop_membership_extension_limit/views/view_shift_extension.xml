<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_shift_extension_tree_inherit" model="ir.ui.view">
        <field name="model">shift.extension</field>
        <field
            name="inherit_id"
            ref="coop_membership.view_shift_extension_tree_inherit"
        />
        <field name="arch" type="xml">
            <field name="current_extension" position="after">
                <field name="is_new" column_invisible="1" />
            </field>
            <xpath expr="//list[@name='shift_extensions']" position="attributes">
                <attribute name="decoration-muted">not is_new</attribute>
            </xpath>
        </field>
    </record>
</odoo>
