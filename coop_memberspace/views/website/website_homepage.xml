<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="coop_memberspace.homepage"
        inherit_id="website.homepage"
        name="Main layout"
        priority="99"
    >
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_empty" t-if="website.user_id != user_id">
                <t t-set="title">Member area | Home</t>
                <div class="container-fluid">
                    <!-- Banner -->
                    <!-- <div style="text-align: center;color:red;margin-top: 10px;border: 1px solid red;margin-left: -15px;margin-right: -15px;">
                        <h3></h3>
                    </div> -->

                    <!-- Status -->
                    <div
                        contenteditable="false"
                        style="text-align: center;margin-left: -15px;margin-right: -15px;"
                        t-att-class="member_status[2]"
                    >
                        <h3
                            style="margin-bottom: 0px;margin-top: 0px;font-size:24px !important;"
                        >
                            <strong>
                                <span t-out="member_status[0] + ' '" />
                            </strong>
                            <span t-out="member_status[1]" />
                        </h3>
                    </div>
                </div>
                <div class="container">
                    <!-- Current Week Information -->
                    <div class="row" style="margin-top: 20px">
                        <div class="col-md-4">
                            <div>
                                <h3
                                    style="font-size: 18px !important;"
                                >My next service</h3>
                                <div
                                    style="border: 1px solid #b2b7bb;padding: 10px;min-height: 115px;"
                                >
                                    <div class="row">
                                        <div
                                            class="col-md-4 col-xs-6"
                                            style="text-align: center"
                                        >
                                            <i
                                                class="material-icons"
                                                style="font-size: 4.5em"
                                            >alarm</i>
                                        </div>
                                        <div class="col-md-4 col-xs-6">
                                            <p class="text-right" t-out="date_begin" />
                                        </div>
                                        <div
                                            class="col-md-4 col-xs-12"
                                            style="text-align: right;margin-top:7px;"
                                        >
                                            <a href="/mywork">
                                                <span
                                                    class="fa fa-caret-right"
                                                    style="font-size: 4em"
                                                />
                                            </a>
                                        </div>
                                    </div>
                                    <!-- <div style="text-align: right;margin-right:35px;">Link My Work</div> -->
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <h3
                                style="font-size: 18px !important;"
                            >Active cooperators</h3>
                            <div
                                class="text-center"
                                style="border: 1px solid #b2b7bb;padding: 10px;"
                            >
                                <p
                                    t-out="'{0:,.0f}'.format(num_of_members).replace(',', ' ')"
                                />
                                <i
                                    class="material-icons"
                                    style="font-size: 3.5em"
                                >accessibility_new</i>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div>
                                <h3
                                    style="font-size: 18px !important;"
                                >Current week</h3>
                                <div
                                    style="border: 1px solid #b2b7bb;padding: 10px;min-height: 115px;"
                                >
                                    <div class="row">
                                        <div
                                            class="col-md-4 col-xs-6"
                                            style="text-align: center"
                                        >
                                            <span
                                                style="font-size: 3em;font-weight: 600;"
                                                t-out="week_name"
                                            />
                                        </div>
                                        <div class="col-md-4 col-xs-6" />
                                        <div
                                            class="col-md-4 col-xs-12"
                                            style="text-align: right;margin-top:7px;"
                                        >
                                            <a href="#">
                                                <span
                                                    class="fa fa-caret-right"
                                                    style="font-size: 4em"
                                                />
                                            </a>
                                        </div>
                                    </div>
                                    <!-- <div style="text-align: right;margin-right:35px;">Link Calendar</div> -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="oe_structure_homepage_bottom" class="oe_structure" />
            </div>
        </xpath>
    </template>
</odoo>
