<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <template id="coop_memberspace.myteam">
        <t t-call="website.layout">
            <t t-set="title">Member area | My team</t>
            <div class="container">
                <div
                    class="row"
                    style="padding-left: 15px;padding-right:15px;margin-top: 30px"
                >
                    <h3>My coordinators
                        <button
                        type="button"
                        style="margin-left: 5px;background-color: transparent;border: 0px;"
                        class="material-icons js-copy"
                        data-bs-toggle="tooltip"
                        t-attf-title="Vous pouvez contacter L’ENSEMBLE de vos coordinateurs en écrivant à #{alias_leader} (cliquez pour copier l’adresse)."
                        t-att-data-copy="alias_leader"
                        data-container="body"
                    >
                            email
                        </button>
                    </h3>
                    <div class="row" style="width: 100%;">
                        <t
                            t-if="coordinators"
                            t-foreach="coordinators"
                            t-as="coordinator"
                        >
                            <div class="col-sm-6 col-md-4 member_kanban">
                                <div class="member_kanban_content">
                                    <div class="member_image">
                                        <img
                                            t-att-src="'/web/image/res.partner/%d/avatar_128' % coordinator.id"
                                        />
                                    </div>
                                    <div class="member_detail">
                                        <h5 class="member_heading">
                                            <strong t-out="coordinator.name" />
                                        </h5>
                                        <ul>
                                            <li>
                                                <t t-if="coordinator.public_email">
                                                    <t t-out="coordinator.email" />
                                                </t>
                                            </li>
                                            <li>
                                                <t t-if="coordinator.public_mobile">
                                                    <t t-out="coordinator.mobile" />
                                                </t>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <div
                    t-if="current_member.shift_type == 'standard'"
                    class="row"
                    style="padding-left: 15px;padding-right:15px;margin-top: 30px"
                >
                    <h3>My team
                        <button
                        type="button"
                        style="margin-left: 5px;background-color: transparent;border: 0px;"
                        class="material-icons js-copy"
                        data-container="body"
                        data-bs-toggle="tooltip"
                        t-attf-title="Vous pouvez contacter L’ENSEMBLE de vos coordinateurs en écrivant à #{alias_team} (cliquez pour copier l’adresse)."
                        t-att-data-copy="alias_team"
                        t-if="is_leader and members"
                    >
                            email
                        </button>
                    </h3>
                    <div class="row" style="width: 100%;">
                        <t t-foreach="members" t-as="member">
                            <div class="col-sm-6 col-md-4 member_kanban">
                                <div class="member_kanban_content">
                                    <div class="member_image">
                                        <img
                                            t-att-src="'/web/image/res.partner/%d/avatar_128' % member.id"
                                        />
                                    </div>
                                    <div class="member_detail">
                                        <h5 class="member_heading">
                                            <strong t-out="member.name" />
                                        </h5>
                                        <ul>
                                            <li>
                                                <t t-if="member.public_email">
                                                    <t t-out="member.email" />
                                                </t>
                                            </li>
                                            <li>
                                                <t t-if="member.public_mobile">
                                                    <t t-out="member.mobile" />
                                                </t>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
