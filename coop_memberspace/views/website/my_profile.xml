<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <template id="coop_memberspace.myprofile">
        <t t-call="website.layout">
            <t t-set="title">Member area | Profile</t>
            <div class="container my_profile">
                <!-- Your Identity -->
                <div>
                    <div class="box-info-times">
                        <div
                            class="collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#your_identify"
                            aria-expanded="false"
                        >
                            <i class="material-icons">perm_contact_calendar</i>
                            <h3 style="margin-left: 45px;">Your identity</h3>
                        </div>
                    </div>
                    <div
                        id="your_identify"
                        class="collapse box-info-content"
                        aria-expanded="true"
                    >
                        <div class="row">
                            <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                <h4>Civility:</h4>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <p
                                    style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                    t-out="user.partner_id and user.partner_id.get_partner_gender_website() or ''"
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                <h4>Last name :</h4>
                            </div>
                            <div class="col-xs-8 col-sm-8 col-md-8">
                                <p
                                    style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                    t-out="user.partner_id.name"
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Your Phone Number -->
                <form method="post" action="/edit-phone">
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <div>
                        <div class="box-info-times">
                            <div
                                class="collapsed"
                                data-bs-toggle="collapse"
                                data-bs-target="#your_phone_number"
                                aria-expanded="false"
                            >
                                <i class="material-icons">contact_phone</i>
                                <h3 style="margin-left: 45px;">Your phone numbers</h3>
                            </div>
                        </div>
                        <div
                            id="your_phone_number"
                            class="collapse box-info-content"
                            aria-expanded="true"
                        >
                            <div class="row">
                                <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                    <h4>Phone number:</h4>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <input
                                        style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                        class="pd-l-3 input-no-edit"
                                        name="mobile"
                                        t-att-value="user.partner_id.mobile"
                                        disabled="disabled"
                                    />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                    <h4>Landline number:</h4>
                                </div>
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <input
                                        style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                        class="pd-l-3 input-no-edit"
                                        name="phone"
                                        t-att-value="user.partner_id.phone"
                                        disabled="disabled"
                                    />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4 col-sm-4 col-md-4 text-right" />
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <button
                                        type="button"
                                        class="btn btn-warning btn-edit-phone"
                                    >Modifier</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- Your Postal Address -->
                <div>
                    <div class="box-info-times">
                        <div
                            class="collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#your_postal_address"
                            aria-expanded="false"
                        >
                            <i class="material-icons">contact_mail</i>
                            <h3 style="margin-left: 45px;">Your mailing address</h3>
                        </div>
                    </div>
                    <form
                        class="edit-postal-address"
                        method="post"
                        action="/edit-address"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />
                        <div
                            id="your_postal_address"
                            class="collapse box-info-content"
                            aria-expanded="true"
                        >
                            <div class="address-edit hide">
                                <div class="row">
                                    <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                        <h4>Rue :</h4>
                                    </div>
                                    <div class="col-xs-8 col-sm-8 col-md-8">
                                        <input
                                            style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                            class="pd-l-3"
                                            name="street"
                                            t-att-value="user.partner_id.street"
                                        />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                        <h4>Code postal :</h4>
                                    </div>
                                    <div class="col-xs-8 col-sm-8 col-md-8">
                                        <input
                                            style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                            class="pd-l-3"
                                            name="zip"
                                            t-att-value="user.partner_id.zip"
                                        />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                        <h4>City :</h4>
                                    </div>
                                    <div class="col-xs-8 col-sm-8 col-md-8">
                                        <input
                                            style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                            class="pd-l-3"
                                            name="city"
                                            t-att-value="user.partner_id.city"
                                        />
                                    </div>
                                </div>
                            </div>
                            <div class="row address-no-edit">
                                <div class="col-xs-4 col-sm-4 col-md-4" />
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <span t-out="user.partner_id.street" />
                                    <br />
                                    <span t-out="user.partner_id.zip" />
                                    <span t-out="user.partner_id.city" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4 col-sm-4 col-md-4" />
                                <div class="col-xs-8 col-sm-8 col-md-8">
                                    <button
                                        type="button"
                                        class="btn btn-warning btn-edit-address"
                                    >Modifier</button>
                                </div>
                            </div>
                            <!-- <div class="row text-center address-no-edit">
                                <span t-out="user.partner_id.street" /> <br/>
                                <span t-out="user.partner_id.zip" />
                                <span t-out="user.partner_id.city" />
                            </div>
                            <div class="row text-center">
                                <button type="button" class="btn btn-warning btn-edit-address">Modifier</button>
                            </div> -->
                        </div>
                    </form>
                </div>

                <!-- Your Display Preferences -->
                <div>
                    <div class="box-info-times">
                        <div
                            class="collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#your_display_reference"
                            aria-expanded="false"
                        >
                            <i class="material-icons">contacts</i>
                            <h3 style="margin-left: 45px;">Your preferences</h3>
                        </div>
                    </div>
                    <div
                        id="your_display_reference"
                        class="collapse box-info-content"
                        aria-expanded="true"
                    >
                        <h4
                            style="margin-left: 15px;font-size: 25px;"
                        >Show to your team</h4>
                        <div class="row">
                            <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                <h4>Photo :</h4>
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <img
                                    class="img-responsive"
                                    t-if="user.partner_id"
                                    t-att-src="'/web/image/res.partner/%d/avatar_128' % user.partner_id.id"
                                />
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label class="switch">
                                    <input
                                        type="checkbox"
                                        name="public_avatar"
                                        t-att-checked="user.partner_id.public_avatar"
                                    />
                                    <span class="slider round" />
                                </label>
                            </div>
                        </div>
                        <hr class="text-center" style="width: 72%" />
                        <div class="row">
                            <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                <h4>Mobile :</h4>
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <p
                                    style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                    t-out="user.partner_id.mobile"
                                />
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label class="switch">
                                    <input
                                        type="checkbox"
                                        name="public_mobile"
                                        t-att-checked="user.partner_id.public_mobile"
                                    />
                                    <span class="slider round" />
                                </label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                <h4>Adresse email :</h4>
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <p
                                    style="margin-top:10px;margin-bottom:10px;font-size:17px;"
                                    t-out="user.partner_id.email"
                                />
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <label class="switch">
                                    <input
                                        type="checkbox"
                                        name="public_email"
                                        t-att-checked="user.partner_id.public_email"
                                    />
                                    <span class="slider round" />
                                </label>
                            </div>
                        </div>
                        <h4
                            t-if="user.partner_id.show_email_receipt"
                            style="margin-left: 15px;font-size: 25px;"
                        >
                            Ticket par email
                        </h4>
                        <div t-if="user.partner_id.show_email_receipt" class="row">
                            <div class="col-xs-4 col-sm-4 col-md-4 text-right">
                                <h4>Activate :</h4>
                            </div>
                            <div class="col-xs-4 col-sm-4 col-md-4" />
                            <div class="col-xs-4 col-sm-4 col-md-4">
                                <form
                                    class="edit-email-pos-receipt"
                                    method="post"
                                    action="/edit-email-pos-receipt"
                                >
                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"
                                    />
                                    <label class="switch">
                                        <input
                                            type="checkbox"
                                            name="pos_email_receipt"
                                            t-att-checked="user.partner_id.pos_email_receipt == 'email_pos_receipt'"
                                            onchange="this.form.submit();"
                                        />
                                        <span class="slider round" />
                                    </label>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
