<?xml version="1.0" ?>
<odoo noupdate="1">
    <record id="email_inform_cannot_send_to_memberspace_alias" model="mail.template">
        <field name="name">Inform User Can Not Send Email To Memberspace Alias</field>
        <field name="model_id" ref="coop_memberspace.model_res_users" />
        <field name="email_from" />
        <field name="email_to" />
        <field name="lang" />
        <field name="reply_to">no-reply@cooplalouve.fr</field>
        <field
            name="subject"
        >You are not authorized to send messages to this alias</field>
        <field name="body_html" type="html">
            <p>You cannot post to this alias: <t t-out="ctx.get('email_add')" /></p>
        </field>
    </record>
</odoo>
