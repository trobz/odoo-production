#. module: coop_memberspace
#: model_terms:ir.ui.view,arch_db:coop_memberspace.mywork_standard
msgid ""
"<span style=\"font-size: 15px;font-weight: 600\">Represent your situation with your\n"
"                                    permanent team. This counter is at \"0\" when you are up to date, it is negative when\n"
"                                    you need to catch up.\n"
"                                </span>"
msgstr ""
"<span style=\"font-size: 15px;font-weight: 600\">Représente votre situation avec votre\n"
"                                    équipe permanente. Ce compteur est à \"0\" quand vous êtes à jour, il est négatif quand\n"
"                                    vous devez rattraper.\n"
"                                </span>"

#. module: coop_memberspace
#: model_terms:ir.ui.view,arch_db:coop_memberspace.mywork_standard
msgid ""
"<span style=\"font-size: 15px;font-weight: 600\">Represents the points accumulated by\n"
"                                    doing services in addition to your usual services. From a total of 2 points, you can\n"
"                                    request early leave.\n"
"                                </span>"
msgstr ""
"<span style=\"font-size: 15px;font-weight: 600\">Représente les points accumulés par\n"
"                                    la réalisation de services en plus de vos services habituels. À un total de 2 points, vous pouvez\n"
"                                    demander un départ anticipé.\n"
"                                </span>"

#. module: coop_memberspace
#: model_terms:ir.ui.view,arch_db:coop_memberspace.mywork_ftop
msgid ""
"<span style=\"font-size: 15px;font-weight: 600\">Your status is “up to date” at zero\n"
"                                    points or more. On the other hand, to be in order for the next steering wheel count\n"
"                                    you must be at +1 or more.\n"
"                                </span>"
msgstr ""
"<span style=\"font-size: 15px;font-weight: 600\">Votre statut est \"à jour\" à zéro\n"
"                                    points ou plus. D'autre part, pour être en règle pour le prochain compte de volant\n"
"                                    vous devez être à +1 ou plus.\n"
"                                </span>"

