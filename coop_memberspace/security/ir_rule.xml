<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Allow MemberSpace edit himself/herself information -->
    <record id="member_space_personal_contact" model="ir.rule">
        <field name="name">MemberSpace Personal Contacts</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field
            name="domain_force"
        >[('is_member', '=', True), ('related_user_id', '=', user.id)]</field>
        <field eval="0" name="perm_read" />
        <field name="groups" eval="[(4, ref('coop_memberspace.group_memberspace'))]" />
    </record>

    <!-- Restrict shift registration write/create to the current member's own records -->
    <record id="member_space_own_shift_registration" model="ir.rule">
        <field name="name">MemberSpace Own Shift Registrations</field>
        <field name="model_id" ref="coop_memberspace.model_shift_registration" />
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field eval="0" name="perm_read" />
        <field eval="1" name="perm_write" />
        <field eval="1" name="perm_create" />
        <field eval="0" name="perm_unlink" />
        <field name="groups" eval="[(4, ref('coop_memberspace.group_memberspace'))]" />
    </record>
</odoo>
