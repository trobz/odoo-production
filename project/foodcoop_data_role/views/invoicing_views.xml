<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account.menu_finance" model="ir.ui.menu">
        <field
            name="groups_id"
            eval="[Command.set([
            ref('foodcoop_data_role.group_Foodcoop_Admin'),
            ref('foodcoop_data_role.group_Accountant'),
            ref('base.group_system'),
        ])]"
        />
    </record>
    <record id="coop_shift.shift_menu" model="ir.ui.menu">
        <field
            name="groups_id"
            eval="[Command.set([
            ref('foodcoop_data_role.group_Teamleader'),
            ref('foodcoop_data_role.group_Foodcoop_Admin'),
            ref('foodcoop_data_role.group_Member_Manager'),
            ref('foodcoop_data_role.group_Member_Accountant'),
            ref('foodcoop_data_role.group_Accountant'),
            ref('foodcoop_data_role.group_BDMLecture'),
            ref('foodcoop_data_role.group_BDMPresence'),
            ref('foodcoop_data_role.group_BDMSaisie'),
            ref('foodcoop_data_role.group_BadgeReader'),
            ref('base.group_system'),
        ])]"
        />
    </record>
    <menuitem
        id="member_accountant_invoicing_menu_root"
        name="Invoicing"
        web_icon="account,static/description/icon.png"
        groups="group_member_accountant_restrict,group_member_Subscription_restrict"
    />
    <menuitem
        id="member_accountant_invoicing_menu_payables"
        name="Vendors"
        parent="member_accountant_invoicing_menu_root"
        groups="group_member_accountant_restrict"
        sequence="10"
    />
    <menuitem
        id="member_accountant_invoicing_menu_entries"
        name="Accounting"
        parent="member_accountant_invoicing_menu_root"
        sequence="20"
    />
    <menuitem
        action="account.action_move_out_invoice_type"
        id="menu_action_invoice_tree2"
        parent="member_accountant_invoicing_menu_payables"
        sequence="1"
    />
    <menuitem
        action="account.action_move_out_refund_type"
        id="menu_action_invoice_in_refund"
        parent="member_accountant_invoicing_menu_payables"
        sequence="5"
    />
    <menuitem
        action="account_check_deposit.action_check_deposit_tree"
        id="menu_check_deposit_tree"
        parent="member_accountant_invoicing_menu_entries"
        sequence="20"
    />
    <menuitem
        id="menu_finance_entries_accounting_entries"
        name="Accounting Entries"
        sequence="10"
        parent="member_accountant_invoicing_menu_entries"
        groups="foodcoop_data_role.group_member_accountant_restrict"
    />
    <menuitem
        action="account.action_move_journal_line"
        id="menu_action_move_journal_line_form"
        parent="menu_finance_entries_accounting_entries"
        sequence="1"
    />
    <menuitem
        action="account.action_move_line_form"
        id="menu_action_account_moves_all"
        parent="menu_finance_entries_accounting_entries"
        sequence="10"
    />
    <menuitem
        name="Analytic Items"
        parent="menu_finance_entries_accounting_entries"
        action="analytic.account_analytic_line_action_entries"
        id="menu_action_analytic_lines_tree"
        sequence="35"
        groups="analytic.group_analytic_accounting"
    />

    <menuitem
        id="menu_finance_entries_actions"
        name="Actions"
        sequence="15"
        parent="member_accountant_invoicing_menu_entries"
        groups="foodcoop_data_role.group_member_accountant_restrict"
    />
    <menuitem
        id="menu_action_manual_reconciliation"
        parent="menu_finance_entries_actions"
        action="account.action_account_reconcile_model"
        sequence="25"
    />
    <menuitem
        action="account_mass_reconcile.action_account_mass_reconcile"
        id="menu_mass_reconcile"
        sequence="30"
        parent="menu_finance_entries_actions"
    />
    <menuitem
        id="menu_export_wrong_reconciliation_ml"
        name="Export wrong reconciliation move lines"
        parent="member_accountant_invoicing_menu_entries"
        groups="foodcoop_data_role.group_member_accountant_restrict"
        action="coop_account.action_export_wrong_reconciliation_ml_client"
        sequence="112"
    />

    <record id="invoice_supplier_form_inherit" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <header position="attributes">
                <attribute
                    name="groups"
                >foodcoop_data_role.group_Cashier,foodcoop_data_role.group_Member_Manager,foodcoop_data_role.group_Accountant,foodcoop_data_role.group_Purchase_Manager,foodcoop_data_role.group_Foodcoop_Admin,foodcoop_data_role.group_POS_Manager,base.group_system,!foodcoop_data_role.group_member_accountant_restrict</attribute>
            </header>
            <header position="after">
                <header
                    name="member_accountant_header"
                    groups="foodcoop_data_role.group_member_accountant_restrict"
                >
                    <button
                        name="action_register_payment"
                        type="object"
                        string="Register Payment"
                        class="oe_highlight"
                        invisible="state != 'posted'"
                    />
                </header>
            </header>
        </field>
    </record>
    <record id="invoice_supplier_form_inherit_2" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="action_post" position="attributes">
                <attribute
                    name="groups"
                >account.group_account_invoice,foodcoop_data_role.group_Purchaser</attribute>
            </button>
        </field>
    </record>
</odoo>
