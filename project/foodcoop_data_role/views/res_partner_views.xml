        ref('foodcoop_data_role.group_BDMSaisie'),
        ref('foodcoop_data_role.group_POS_Manager'),
        ref('foodcoop_data_role.group_Member_Accountant'),
        ref('foodcoop_data_role.group_Staff'),
        ref('foodcoop_data_role.group_Communications_Officer'),
