        ref('foodcoop_data_role.group_Inventory_Manager'),
        ref('foodcoop_data_role.group_Teamleader'),
        ref('foodcoop_data_role.group_Purchase_Manager'),
        ref('foodcoop_data_role.group_Foodcoop_Admin'),
