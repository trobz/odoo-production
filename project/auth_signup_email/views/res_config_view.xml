<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='user_default_rights']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" groups="base.group_no_one">
                    <div class="o_setting_left_pane">
                        <field name="prevent_signup_email"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="prevent_signup_email"/>
                        <div class="text-muted">
                            Tick this option to prevent sending email `Auth Signup: Odoo Connection` when signing up new user
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
