<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- S#T36919 - Adjustments to Timesheet Report-->
    <template id="report_timesheet" inherit_id="coop_shift.report_timesheet">
        <xpath expr="//table[1]/thead" position="replace">
            <!-- To reverse the position of 2 rows of header -->
            <thead>
                <tr>
                    <th class="text-center" colspan="5">MEMBRE PROGRAMMÉ</th>
                    <th class="text-center" style="border-left: 4px solid #ddd;" colspan="4">MEMBRE PRÉSENT</th>
                </tr>
                <!-- Add text-transform: uppercase;-->
                <tr style="font-size:11px;background:#DDDDDD;text-transform: uppercase;">
                    <th class="text-center" width="6%">Statut</th>
                    <th class="text-center" width="6%">RAT</th>
                    <th class="text-center" width="8%">QLÉ</th>
                    <!-- Replace "Numéro" by "N°" -->
                    <th class="text-center" width="8%">N°</th>
                    <th class="text-center" width="22%">Nom</th>
                    <!-- Replace "Echange" by "COCHER SI ECH." -->
                    <th class="text-center">Cocher si ech.</th>
                    <!-- Replace "Numéro" by "N°" -->
                    <th class="text-center" width="8%">N°</th>
                    <th class="text-center" width="28%">NOM (DÉBUT)</th>
                    <th class="text-center" width="8%">SIGNATURE (FIN)</th>
                </tr>
            </thead>
        </xpath>
        <xpath expr="//div[hasclass('page')][2]/table/thead" position="replace">
            <!-- To reverse the position of 2 rows of header -->
            <thead>
                <tr>
                    <th class="text-center" colspan="2">MEMBRE CRÉDITÉ</th>
                    <th class="text-center" style="border-left: 4px solid #ddd;" colspan="4">MEMBRE PRÉSENT</th>
                </tr>
                <!-- Add text-transform: uppercase;-->
                <tr style="font-size:11px;background:#DDDDDD;text-transform: uppercase;">
                    <!-- Replace "Numéro" by "NUM" -->
                    <th class="text-center" width="15%">Num</th>
                    <th class="text-center" width="35%">Nom</th>
                    <!-- Replace "Echange" by "COCHER SI ECH." -->
                    <th class="text-center">Cocher si ech.</th>
                    <!-- Replace "Numéro" by "NUM" -->
                    <th class="text-center" width="8%">Num</th>
                    <th class="text-center" width="28%">NOM (DÉBUT)</th>
                    <th class="text-center" width="8%">SIGNATURE (FIN)</th>
                </tr>
            </thead>
        </xpath>

        <!-- Add checkbox inside `Cocher si ech`-->
        <xpath expr="//table[1]/tbody/tr[1]/td[@style='border-left: 4px solid #ddd']" position="inside">
            <input type="checkbox"/>
        </xpath>
        <xpath expr="//table[1]/tbody/tr[2]/td[@style='border-left: 4px solid #ddd']" position="inside">
            <input type="checkbox"/>
        </xpath>
        <xpath expr="//table[1]/tbody/tr[4]/td[@style='border-left: 4px solid #ddd']" position="inside">
            <input type="checkbox"/>
        </xpath>
        <xpath expr="//table[1]/tbody/tr[5]/td[@style='border-left: 4px solid #ddd']" position="inside">
            <input type="checkbox"/>
        </xpath>
        <!-- Table 2 -->
        <xpath expr="//div[hasclass('page')][2]/table/tbody/tr[1]/td[@style='border-left: 4px solid #ddd']" position="inside">
            <input type="checkbox"/>
        </xpath>

        <!-- Add background `background:#DDDDDD` for the column `Cocher si ech`-->
        <!-- Table 1 -->
        <xpath expr="//table[1]/tbody/tr[1]/td[@style='border-left: 4px solid #ddd']" position="attributes">
            <attribute name="style">border-left: 4px solid #ddd; background:#DDDDDD; text-align:center;</attribute>
        </xpath>
        <xpath expr="//table[1]/tbody/tr[2]/td[@style='border-left: 4px solid #ddd']" position="attributes">
            <attribute name="style">border-left: 4px solid #ddd; background:#DDDDDD; text-align:center;</attribute>
        </xpath>
        <xpath expr="//table[1]/tbody/tr[4]/td[@style='border-left: 4px solid #ddd']" position="attributes">
            <attribute name="style">border-left: 4px solid #ddd; background:#DDDDDD; text-align:center;</attribute>
        </xpath>
        <xpath expr="//table[1]/tbody/tr[5]/td[@style='border-left: 4px solid #ddd']" position="attributes">
            <attribute name="style">border-left: 4px solid #ddd; background:#DDDDDD; text-align:center;</attribute>
        </xpath>
        <!-- Table 2 -->
        <xpath expr="//div[hasclass('page')][2]/table/tbody/tr[1]/td[@style='border-left: 4px solid #ddd']" position="attributes">
            <attribute name="style">border-left: 4px solid #ddd; background:#DDDDDD; text-align:center;</attribute>
        </xpath>

        <!-- F#T64921 -->
        <xpath expr="//h2[@style='background:#DDDDDD;margin-left:15px;margin-right:15px;padding:20px']/strong" position="replace">
            <strong> RATTRAPAGES <span style="font-size: 15px;">REMPLIR LES 2 COLONNES</span></strong>
        </xpath>
    </template>

</odoo>
