<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_price" inherit_id="website_sale.product_price">
        <xpath expr="//span[@itemprop='priceCurrency']" position="after">
            <span t-if="product.price_weight or product.price_volume" class="price_pricetag">
                (
                    <t t-if="product.price_weight">
                        <span  class="oe_price" style="white-space: nowrap;" t-esc="product.price_weight" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>/kg
                    </t>
                    <t t-if="product.price_weight and product.price_volume"> or </t>
                    <t  t-if="product.price_volume">
                        <span class="oe_price" style="white-space: nowrap;" t-esc="product.price_volume" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>/L
                    </t>
                )
            </span>
        </xpath>
    </template>
</odoo>
