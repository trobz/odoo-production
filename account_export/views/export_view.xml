<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_export_form" model="ir.ui.view">
        <field name="name">Account Export</field>
        <field name="model">account.export</field>
        <field name="arch" type="xml">
            <form string="Account Export">
                <sheet>
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" />
                    </h1>
                    <group string="Options">
                        <group>
                            <field name="filter_move_lines" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="config_id" />
                        </group>
                        <group>
                            <field name="last_export_date" />
                        </group>
                    </group>
                    <separator string="Filters" />
                    <notebook>
                        <page string="Dates">
                            <group>
                                <group>
                                    <field
                                        name="date_from"
                                        help="Move lines created after"
                                    />
                                </group>
                                <group>
                                    <field
                                        name="date_to"
                                        help="Move lines created before"
                                    />
                                </group>
                            </group>
                        </page>
                        <page string="Invoices">
                            <field name="invoice_ids" />
                        </page>
                        <page string="Journals">
                            <field name="journal_ids" />
                        </page>
                        <page string="Partners">
                            <field name="partner_ids" />
                        </page>
                    </notebook>
                    <button
                        name="action_create_report"
                        string="Export"
                        type="object"
                        default_focus="1"
                        class="oe_highlight mt-3"
                    />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_attachment_tree" model="ir.ui.view">
        <field name="name">Account Export</field>
        <field name="model">account.export</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="last_export_date" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_account_export_search" model="ir.ui.view">
        <field name="model">account.export</field>
        <field name="arch" type="xml">
            <search string="Account Export">
                <filter
                    name="my_exports_filter"
                    string="My Exports"
                    domain="[('create_uid', '=', uid)]"
                    help="Filter on my exports"
                />
            </search>
        </field>
    </record>

    <record id="view_account_export_config_form" model="ir.ui.view">
        <field name="name">Account Export Configuration</field>
        <field name="model">account.export.config</field>
        <field name="arch" type="xml">
            <form string="Account Export Config">
                <sheet>
                    <field name="active" invisible="1" />
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group string="Settings">
                            <field name="is_default" />
                        </group>
                        <group string="Format">
                            <field name="credit_debit_format" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="field_type" />
                                    <field name="name" />
                                    <field name="description" />
                                    <field name="transform_expr" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_export_config_tree" model="ir.ui.view">
        <field name="name">Account Export Configuration</field>
        <field name="model">account.export.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="is_default" />
            </list>
        </field>
    </record>

    <record id="action_account_export" model="ir.actions.act_window">
        <field name="name">Account Export</field>
        <field name="res_model">account.export</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_export_search" />
    </record>

    <record id="action_export_config" model="ir.actions.act_window">
        <field name="name">Export Configuration</field>
        <field name="res_model">account.export.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_account_exports"
        parent="account.menu_finance_reports"
        name="Exports"
        sequence="4"
    />
    <menuitem
        id="menu_account_export_moves"
        parent="menu_account_exports"
        name="Export Moves"
        action="action_account_export"
        sequence="10"
    />
    <menuitem
        id="menu_move_to_export"
        parent="menu_account_exports"
        name="Moves to export"
        action="action_moves_to_export"
        sequence="20"
    />
    <menuitem
        id="menu_account_export_config"
        parent="menu_account_exports"
        name="Export Configuration"
        action="action_export_config"
        sequence="30"
    />
</odoo>
