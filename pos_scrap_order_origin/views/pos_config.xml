<?xml version="1.0"?>
<odoo>

    <record id="pos_config_view_form_inherit" model="ir.ui.view">
        <field name="name">pos_config_view_form_inherit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="pos_scrap_order.pos_config_view_form_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='inventory_scrap']"
                position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="scrap_origins">
                    <div class="o_setting_right_pane">
                        <label for="scrap_origin_ids"/>
                        <div class="content-group mt16">
                            <field name="scrap_origin_ids" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
