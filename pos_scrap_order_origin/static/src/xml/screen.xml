<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ScrapScreen-Origins">
        <div class='scrap-origin'>
            <t t-foreach="scrapOrigins" t-as="origin">
                <div class="button origin" t-att-data-id="origin.id">
                    <t t-esc="origin.name" />
                </div>
            </t>
        </div>
    </t>

</templates>
