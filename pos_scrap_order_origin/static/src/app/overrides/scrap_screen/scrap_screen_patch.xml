<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <!-- Inject reason tag selector into ScrapScreen -->
    <t t-inherit="pos_scrap_order.ScrapScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('scrap-left')]" position="inside">
            <t t-if="originState.reasonTags.length">
                <div class="mb-3 px-3 pt-3">
                    <label class="form-label fw-bold">Scrap Reason</label>
                    <div class="scrap-origins d-flex flex-wrap gap-2">
                        <button
                            t-foreach="originState.reasonTags"
                            t-as="tag"
                            t-key="tag.id"
                            t-att-class="'origin-btn btn btn-outline-primary' + (originState.selectedReasonTagId === tag.id ? ' active' : '')"
                            t-on-click="() => this.selectReasonTag(tag.id)"
                            t-esc="tag.name"
                        />
                    </div>
                </div>
            </t>
        </xpath>
    </t>

</templates>
