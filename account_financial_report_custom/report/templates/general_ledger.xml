<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_general_ledger_lines_inherit" inherit_id="account_financial_report.report_general_ledger_lines">
        <xpath expr="//t[@t-foreach='account_or_partner_object.move_line_ids']" position="replace">
            <!-- Display each lines -->
            <t t-set="data_lines" t-value="account_or_partner_object.move_line_ids.group_by_move_partner()"/>
            <t t-foreach="data_lines" t-as="line">
                <!-- # lines or centralized lines -->
                <div class="act_as_row lines">
                    <!--## date-->
                    <div class="act_as_cell left">
                        <span>
                            <t t-esc="line.date" t-options="{'widget': 'date'}"/>
                        </span>
                    </div>
                    <!--## move-->
                    <div class="act_as_cell left">
                        <span>
                            <t t-raw="line.entry"/>
                        </span>
                    </div>
                    <!--## journal-->
                    <div class="act_as_cell left">
                        <span>
                            <t t-raw="line.journal"/>
                        </span>
                    </div>
                    <!--## account code-->
                    <div class="act_as_cell left">
                        <span>
                            <t t-raw="line.account"/>
                        </span>
                    </div>
                    <!--## taxes-->
                    <div class="act_as_cell left"><span t-raw="line.taxes_description"/></div>
                    <!--## partner-->
                    <div class="act_as_cell left">
                        <span t-if="line.partner">
                            <t t-raw="line.partner"/>
                        </span>
                    </div>
                    <!--## ref - label-->
                    <div class="act_as_cell left">
                        <span>
                            <t t-raw="line.label"/>
                        </span>
                    </div>
                    <!--## cost_center-->
                    <t t-if="show_cost_center">
                        <div class="act_as_cell left">
                            <span t-if="line.cost_center">
                                <t t-raw="line.cost_center"/>
                            </span>
                        </div>
                    </t>
                    <t t-if="show_analytic_tags">
                        <!--## analytic tags-->
                        <div class="act_as_cell left"><span t-raw="line.tags"/></div>
                    </t>
                    <!--## matching_number-->
                    <div class="act_as_cell">
                        <span t-if="line.matching_number">
                            <t t-raw="line.matching_number"/>
                        </span>
                    </div>
                    <!--## debit-->
                    <div class="act_as_cell amount">
                        <span>
                            <t t-raw="line.debit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </span>
                    </div>
                    <!--## credit-->
                    <div class="act_as_cell amount">
                        <span>
                            <t t-raw="line.credit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </span>
                    </div>

                    <!--## balance cumulated-->
                    <div class="act_as_cell amount">
                        <span>
                            <t t-raw="line.cumul_balance" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </span>
                    </div>
                    <t t-if="foreign_currency">
                        <t t-if="line.currency_id.id">
                            <!--## currency_name-->
                            <div class="act_as_cell amount" style="width: 2.08%;">
                                <span t-esc="line.currency_id.display_name"/>
                            </div>
                            <!--## amount_currency-->
                            <div class="act_as_cell amount" style="width: 5.19%;">
                                <span>
                                    <t t-raw="line.amount_currency" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                </span>
                            </div>
                        </t>
                        <t t-if="not line.currency_id.id">
                            <!--## currency_name-->
                            <div class="act_as_cell amount" style="width: 2.08%;"/>
                            <!--## amount_currency-->
                            <div class="act_as_cell amount" style="width: 5.19%;"/>
                        </t>
                    </t>
                </div>
            </t>
        </xpath>
    </template>


</odoo>
