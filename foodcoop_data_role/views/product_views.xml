<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_template_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="coop_product_coefficient.view_product_template_form"
        />
        <field name="arch" type="xml">
            <page name="coefficient" position="attributes">
                <attribute
                    name="groups"
                >sales_team.group_sale_manager,foodcoop_data_role.group_Purchaser</attribute>
            </page>
        </field>
    </record>

    <!-- Hide the "History" tab from Inventory Manager. -->
    <record id="view_template_history_form_restrict" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_history.view_template_history_form" />
        <field name="arch" type="xml">
            <page name="history" position="attributes">
                <attribute
                    name="groups"
                >foodcoop_data_role.group_Purchaser,foodcoop_data_role.group_Purchase_Manager,foodcoop_data_role.group_Accountant,foodcoop_data_role.group_Foodcoop_Admin,base.group_system</attribute>
            </page>
        </field>
    </record>
</odoo>
