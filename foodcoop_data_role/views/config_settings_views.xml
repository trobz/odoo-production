<?xml version="1.0" ?>
<odoo>
    <record id="res_config_settings_view_form_shift_settings" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="coop_membership.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='shift_settings']" position="attributes">
                <attribute
                    name="groups"
                >base.group_system,foodcoop_data_role.group_Foodcoop_Admin</attribute>
            </xpath>
        </field>
    </record>
</odoo>
