<?xml version="1.0" ?>
<odoo noupdate="1">
    <!-- Foodcoop Admin can delete Favourite (global) filters -->
    <record id="ir_filters_foodcoop_admin_all_rule" model="ir.rule">
        <field name="name">ir.filters: Foodcoop Admin all rights</field>
        <field name="model_id" ref="base.model_ir_filters" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('foodcoop_data_role.group_Foodcoop_Admin'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
