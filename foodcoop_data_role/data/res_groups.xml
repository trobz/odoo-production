    <!-- Remove Todo menu for all roles (Apps already restricted to base.group_system) -->
    <record model="ir.ui.menu" id="project_todo.menu_todo_todos">
        <field name="groups_id" eval="[Command.set([ref('base.group_system')])]" />
    </record>

    <!-- Remove 'Employees / Employee Limit' from Employee and Dashboard HR menus;
         add 'Employees / Manager' to Dashboard -->
    <record model="ir.ui.menu" id="hr.menu_hr_root">
        <field
            name="groups_id"
            eval="[
                Command.unlink(ref('coop_membership.group_employee_native_menu')),
                Command.link(ref('hr.group_hr_manager')),
                Command.link(ref('group_Member_Manager')),
            ]"
        />
    </record>
    <record model="ir.ui.menu" id="hr.menu_hr_main">
        <field
            name="groups_id"
            eval="[
            Command.unlink(ref('coop_membership.group_employee_native_menu')),
            Command.link(ref('hr.group_hr_manager')),
        ]"
        />
    </record>

    <!-- Member Manager: read-only access to the Employees list only, not
         Reporting/Configuration/Departments (those still require hr.group_hr_user
         or hr.group_hr_manager). -->
    <record model="ir.ui.menu" id="hr.menu_hr_employee_payroll">
        <field name="groups_id" eval="[Command.link(ref('group_Member_Manager'))]" />
    </record>
    <record
        model="ir.ui.menu"
        id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
    >
        <field name="groups_id" eval="[Command.link(ref('hr.group_hr_manager'))]" />
    </record>
    <record model="ir.ui.menu" id="base.menu_management">
        <field name="groups_id" eval="[Command.link(ref('base.group_system'))]" />
    </record>
