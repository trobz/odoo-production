<?xml version="1.0"?>
<odoo>
    <record id="view_order_product_search_inherit" model="ir.ui.view">
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <filter name="filter_order_date" position="after">
                <separator/>
                <filter name="Today" string="Order Date: Today" domain="[('date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).to_utc()), ('date','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)).to_utc())]"/>
            </filter>
        </field>
    </record>
    <record id="sale.action_order_report_all" model="ir.actions.act_window">
        <!-- add new context values -->
        <!-- 
        'search_default_Today': 1, 'pivot_measures': ['product_uom_qty', 'price_total',  'price_subtotal', '__count']
        -->
        <!-- remove: 'search_default_filter_order_date': 1 -->
        <field name="context">{'search_default_Sales':1,'group_by':[], 'search_default_Today': 1, 'pivot_measures': ['product_uom_qty', 'price_total',  'price_subtotal', '__count']}</field>
    </record>
</odoo>
