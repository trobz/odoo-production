<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_label_tree" model="ir.ui.view">
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="website" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_product_label_form" model="ir.ui.view">
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <form string="Label">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar oe_left" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                        <label for="code" />
                        <h2>
                            <field name="code" />
                        </h2>
                        <label for="scale_logo_code" />
                        <h2>
                            <field name="scale_logo_code" />
                        </h2>
                    </div>
                    <notebook>
                        <page string="Information">
                            <group>
                                <field name="active" />
                                <field
                                    name="company_id"
                                    groups="base.group_multi_company"
                                />
                                <newline />
                                <field name="website" />
                                <field name="note" widget="html" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_label_kanban2" model="ir.ui.view">
        <field name="name">Product label Kanban</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <field name="image" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_box oe_kanban_color_border">
                            <div class="product_label_kanban">
                                <div class="product_label_kanban_name">
                                    <field name="name" />
                                </div>
                                <div class="product_label_kanban_image">
                                    <img
                                        t-att-src="'/web/image/product.label/' + record.id.raw_value + '/image'"
                                        alt="product label"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_product_label" model="ir.actions.act_window">
        <field name="name">Labels</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.label</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem
        id="menu_product_label"
        parent="purchase.menu_procurement_management"
        action="action_product_label"
        sequence="150"
    />
</odoo>
