<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_print_category.pricetag" model="ir.actions.report">
        <field name="name">Pricetags</field>
        <field name="model">product.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coop_default_pricetag.report_pricetag</field>
        <field name="report_file">coop_default_pricetag.report_pricetag</field>
        <field name="attachment_use" eval="False" />
        <field name="paperformat_id" ref="coop_default_pricetag.paperformat_pricetag" />
        <field
            name="print_report_name"
        >(object.line_ids[0].print_category_id.name + ' Pricetags') if object.line_ids[0].print_category_id.name else 'Pricetags'</field>
    </record>

