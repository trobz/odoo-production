<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="lalouve_custom.ControlButtons"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o_pricelist_button')]" position="attributes">
            <attribute name="t-att-disabled">!allowControlButtons</attribute>
        </xpath>
        <xpath
            expr="//button[@t-on-click='() => this.clickRefund()']"
            position="attributes"
        >
            <attribute name="t-att-disabled">!allowControlButtons</attribute>
        </xpath>
        <xpath
            expr="//button[hasclass('o_fiscal_position_button')]"
            position="attributes"
        >
            <attribute name="t-att-disabled">!allowControlButtons</attribute>
        </xpath>
        <xpath
            expr="//button[@t-on-click='() => this.onClickQuotation()']"
            position="attributes"
        >
            <attribute name="t-att-disabled">!allowControlButtons</attribute>
        </xpath>
    </t>
</templates>
