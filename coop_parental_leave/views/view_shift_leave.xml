<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_shift_leave_form" model="ir.ui.view">
        <field name="model">shift.leave</field>
        <field name="inherit_id" ref="coop_shift.view_shift_leave_form" />
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field
                    name="expected_birthdate"
                    invisible="not is_parental_leave"
                    required="is_parental_leave"
                    string="Expected or actual birthdate : (to be entered first)"
                />
                <field name="is_parental_leave" invisible="1" />
            </field>
            <field name="type_id" position="after">
                <field
                    name="provided_birth_certificate"
                    invisible="not is_parental_leave"
                />
                <field name="shared_leave" invisible="not is_parental_leave" />
                <field
                    name="shared_partner_id"
                    invisible="not is_parental_leave or not shared_leave"
                />
            </field>
            <xpath expr="//sheet//group" position="after">
                <group invisible="not is_parental_leave or not is_exceeded_stop_date">
                    <p class='alert alert-warning' role="alert">
                        The proposed leave exceeds 12 months. Is this a case of multiple birth?
                        <button string="Yes" type="object" name="ok" class="oe_link" />
                        <button
                        type="object"
                        name="revert_stop_date_parental_leave"
                        string="No"
                        class="oe_link"
                    />
                    </p>
                </group>
                <group invisible="not is_parental_leave or not is_warning_start_date">
                    <p class='alert alert-warning' role="alert">
                        Do you confirm the leave should start earlier than 12 weeks before the expected birthdate?
                        <button
                        string="Yes"
                        type="object"
                        name="ok"
                        class="oe_link"
                    /><br />
                    </p>
                </group>
            </xpath>
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,done,cancel</attribute>
            </field>
        </field>
    </record>
</odoo>
