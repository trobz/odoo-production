<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_inventory_barcode_form_inherit" model="ir.ui.view">
        <field name="inherit_id" ref="stock_inventory.view_inventory_group_form" />
        <field name="model">stock.inventory</field>
        <field name="arch" type="xml">
            <field name="product_selection" position="before">
                <field
                    name="scan_barcode_mode"
                    widget="radio"
                    options="{'horizontal': true}"
                    readonly="state == 'done'"
                />
                <field
                    name="use_latest_qty"
                    invisible="scan_barcode_mode != 'add'"
                    readonly="state == 'done'"
                />
            </field>
        </field>
    </record>
</odoo>
