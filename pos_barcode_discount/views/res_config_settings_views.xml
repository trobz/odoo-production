<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.point_of_sale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95" />
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='price_control']" position="after">
                <setting
                    id="discount_categories"
                    string="Discount By Categories"
                    help="Enable this option to apply the discount for a specific categoy when scanning a discount barcode"
                >
                    <field name="pos_discount_by_category" />
                    <field
                        name="pos_discount_category_ids"
                        widget="many2many_tags"
                        invisible="not pos_discount_by_category"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
