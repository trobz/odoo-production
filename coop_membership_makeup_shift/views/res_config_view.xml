<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="coop_memberspace.res_config_settings_view_form_inherit"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='memberspace_shift_exchange_settings']"
                position="inside"
            >
                <setting id="shift_makeup_setting">
                    <field name="shift_makeup" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
