<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="assets" name="pos_receipt_attachment assets" inherit_id="point_of_sale.assets">
        <xpath expr="." position="inside">
            <script
                type="text/javascript"
                src="/pos_receipt_attachment/static/src/js/lib/html2canvas.js"
            />
            <script
                type="text/javascript"
                src="/pos_receipt_attachment/static/src/js/pos_receipt_attachment.js"
            />
            <script
                type="text/javascript"
                src="/pos_receipt_attachment/static/src/js/screens.js"
            />
        </xpath>
    </template>
    <template id="report_assets_common" inherit_id="web.report_assets_common" name="Receipt Attachment Report Assets Comment">
         <xpath expr="." position="inside">
            <link href="/pos_receipt_attachment/static/src/css/print.css" rel="stylesheet"/>
        </xpath>
    </template>
</odoo>
