<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div>
                    <img t-if="o.image_receipt" t-att-src="image_data_uri(o.image_receipt)"/>
                </div>
            </t>
        </t>
    </template>
    <record id="action_report_pos_receipt" model="ir.actions.report">
        <field name="name">Receipt from POS UI</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_receipt_attachment.report_receipt</field>
        <field name="report_file">pos_receipt_attachment.report_receipt</field>
        <field name="print_report_name">'Receipt - %s' % (object.name)</field>
        <field name="paperformat_id" ref="pos_receipt_attachment.paperformat_posreceipt"/>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
    </record>

</odoo>
