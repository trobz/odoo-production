<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- QWeb Reports -->
    <record id="action_report_capital_certificate" model="ir.actions.report">
        <field name="name">Capital Certificate</field>
        <field name="model">capital.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >coop_capital_certificate.report_capital_certificate</field>
        <field
            name="attachment"
        >(object.partner_id.name+' - '+str(object.year)+'.pdf').replace(',','')</field>
        <field
            name="print_report_name"
        >(object.partner_id.name+' - '+str(object.year).replace(',',''))</field>
    </record>
</odoo>
