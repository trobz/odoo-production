<?xml version="1.0" ?>
<odoo noupdate="1">
    <record id="capital_certificate_mail_template" model="mail.template">
        <field name="name">Capital Certificate</field>
        <field
            name="model_id"
            ref="coop_capital_certificate.model_capital_certificate"
        />
        <field
            name="email_from"
        >{{ (object.partner_id.company_id.partner_id.email or '') }}</field>
        <field name="email_to">{{ object.partner_id.email or '' }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True" />
        <field
            name="report_template_ids"
            eval="[(4, ref('action_report_capital_certificate'))]"
        />
        <field
            name="reply_to"
        >{{ object.partner_id.company_id.partner_id.email or '' }}</field>
        <field name="subject">Your fiscal certificate for year {{ object.year }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.partner_id.name" />,</p>
                <p>
                    Please find attached your Fiscal Capital Certificate for year <t
                    t-out="object.year"
                />.
                </p>
                <p>Best regards</p>
            </div>
        </field>
    </record>
</odoo>
