<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_account_payment_form_extend">
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name="payment_type" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="journal_id" position="attributes">
                <attribute
                    name="options"
                >{'no_open': True, 'no_create': True}</attribute>
                <attribute name="string">Account Journal</attribute>
            </field>
            <field name="memo" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </field>
            <field name="memo" position="before">
                <field name="operation_type" readonly="state != 'draft'" />
                <field
                    name="text_check_code"
                    invisible="operation_type != 'check'"
                    readonly="state != 'draft'"
                    required="operation_type == 'check'"
                />
                <field
                    name="text_lcr_code"
                    invisible="operation_type != 'lcr'"
                    readonly="state != 'draft'"
                    required="operation_type == 'lcr'"
                />
            </field>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree" />
        <field name="arch" type="xml">
            <field name="company_id" position="before">
                <field name="invoice_ids" />
            </field>
            <field name="partner_id" position="after">
                <field name="memo" />
            </field>
            <field name="date" position="before">
                <field name="partner_code" />
            </field>
        </field>
    </record>

    <record id="view_account_supplier_payment_tree_inherit" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree" />
        <field name="arch" type="xml">
            <field name="company_id" position="before">
                <field name="invoice_ids" />
            </field>
        </field>
    </record>

    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_code" />
            </field>
        </field>
    </record>
</odoo>
