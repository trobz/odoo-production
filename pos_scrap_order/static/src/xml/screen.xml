<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ScrapButton">
        <button class='control-button main o_container_button'>
            <i class="fa fa-trash-o"></i> Make Scrap Order
        </button>
    </t>

    <t t-name="ScrapScreenWidget">
        <div class='scrap-screen screen'>
            <div class='screen-content'>
                <div class='top-content'>
                    <span class='button back'>
                        <i class='fa fa-angle-double-left'></i>
                        Back
                    </span>
                    <h1>Scrap Order</h1>
                    <span class='button next highlight'>
                        Create Scrap Order
                        <i class='fa fa-angle-double-right'></i>
                    </span>
                </div>
                <div class='left-content pc40 touch-scrollable scrollable-y'>
                    <div class='pos-scrap-left-container'>
                    </div>
                </div>
                <div class="right-content pc60 touch-scrollable scrollable-y">
                    <div class="pos-scrap-note">
                        <div>ATTENTION</div>
                        <span>This action will move these products below into the scrap location</span>
                    </div>
                    <div class="pos-scrap-container">
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="ScrapLines">
        <div class="pos-scraps">

            <div class="pos-center-align"><t t-esc="order.formatted_validation_date"/> <t t-esc="order.name"/></div>
            <br />

            <table class='scrap-orderlines'>
                <colgroup>
                    <col width='50%' />
                    <col width='25%' />
                    <col width='25%' />
                </colgroup>
                <tr t-foreach="orderlines" t-as="orderline">
                    <td>
                        <t t-esc="orderline.get_product().display_name"/>
                    </td>
                    <td class="pos-right-align">
                        <t t-esc="orderline.get_quantity_str_with_unit()"/>
                    </td>
                    <td class="pos-right-align">
                        <t t-esc="widget.format_currency(orderline.get_display_price())"/>
                    </td>
                </tr>
            </table>
            <br />
        </div>
    </t>
</templates>
