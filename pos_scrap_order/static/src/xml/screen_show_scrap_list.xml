<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="ShowScrapListButton">
        <button class="control-button second mode-button">
            List
        </button>
    </t>
    <t t-name="ScrapListScreenWidget">
        <div class='scraplist-screen screen'>
            <div class='screen-content'>
                <section class='top-content'>
                    <span class='button back'>
                        <i class='fa fa-angle-double-left' />
                        Back
                    </span>
                    <h1>Scrap Orders</h1>
                    <span class='button next highlight'>
                        Make Scrap Order
                        <i class='fa fa-angle-double-right' />
                    </span>
                </section>
                <section class="full-content">
                    <div class="window">
                        <section class="subwindow">
                            <div class="subwindow-container">
                                <div
                                    class="subwindow-container-fix touch-scrollable scrollable-y"
                                >
                                    <table class="container-list">
                                        <thead>
                                            <tr>
                                                <th>Reference</th>
                                                <th>Product</th>
                                                <th>Quantity</th>
                                                <th>Create Date</th>
                                                <th>Origin</th>
                                            </tr>
                                        </thead>
                                        <tbody class="scrap-list-contents" />
                                    </table>
                                </div>
                            </div>
                        </section>
                    </div>
                </section>
            </div>
        </div>
    </t>

    <t t-name="ScrapListLine">
        <tr class="container-line" t-att-data-id="scrapOrder.id">
            <td>
                <t t-esc="scrapOrder.name" />
            </td>
            <td>
                <t t-esc="scrapOrder.product_display_name" />
            </td>
            <td>
                <t t-esc="scrapOrder.qty_str" />
            </td>
            <td>
                <t t-esc="scrapOrder.date" />
            </td>
            <td>
                <t t-esc="scrapOrder.origin" />
            </td>
        </tr>
    </t>
</templates>
