<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_inventory_coop" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_name" column_invisible="1" />
            </xpath>

            <xpath expr="//list" position="attributes">
                <attribute
                    name="decoration-danger"
                >inventory_quantity_set and inventory_quantity != quantity</attribute>
                <attribute name="default_order">product_name</attribute>
            </xpath>
        </field>
    </record>
</odoo>
