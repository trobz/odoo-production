<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_inventory_coop" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_name" column_invisible="1" />
            </xpath>

            <xpath expr="//list" position="attributes">
                <attribute
                    name="decoration-danger"
                >inventory_quantity_set and inventory_quantity != quantity</attribute>
                <attribute name="default_order">product_name</attribute>
            </xpath>
            <field name="lot_id" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </field>
            <field name="package_id" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </field>
            <field name="package_id" position="after">
                <field name="package_qty" />
            </field>
        </field>
    </record>
    <record id="view_stock_inventory_form_inherit" model="ir.ui.view">
        <field name="name">view_stock_inventory_form_inherit</field>
        <field name="inherit_id" ref="stock_inventory.view_inventory_group_form" />
        <field name="model">stock.inventory</field>
        <field name="arch" type="xml">
            <button name="action_view_inventory_adjustment" position="before">
                <button
                    type="object"
                    name="action_print_report_inventory"
                    class="oe_stat_button"
                    icon="fa-print"
                    invisible="state in ('cancel',)"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Print</span>
                    </div>
                </button>
            </button>
        </field>
    </record>
</odoo>
