<odoo>
    <record id="view_bank_statement_form" model="ir.ui.view">
        <field
            name="inherit_id"
            ref="account_statement_base.view_bank_statement_form"
        />
        <field name="model">account.bank.statement</field>
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button
                        string="Auto Reconcile Expenses"
                        name="button_reconcile_bank_expense"
                        type="object"
                        invisible="not can_reconcile_pos or not line_ids"
                    />
                    <button
                        string="Auto Reconcile POS Payments"
                        name="button_reconcile_pos"
                        type="object"
                        invisible="not can_reconcile_pos or not line_ids"
                    />
                </header>
            </sheet>
        </field>
    </record>
</odoo>
