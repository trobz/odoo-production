<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="coop_membership.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='shift_state_delay_duration_setting']"
                position="after"
            >
                <setting id="shift_max_available_seats_setting">
                    <field name="shift_max_available_seats" widget="radio" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
