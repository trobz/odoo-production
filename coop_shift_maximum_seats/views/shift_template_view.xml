<?xml version="1.0" ?>
<odoo>
    <record id="view_shift_template_form_inherit" model="ir.ui.view">
        <field name="model">shift.template</field>
        <field
            name="inherit_id"
            ref="coop_membership.view_shift_template_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="seats_availability" position="after">
                <field name="shift_max_available_seats" invisible="1" />
            </field>
            <field name="seats_availability" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('shift_max_available_seats', '=', 'auto')]}</attribute>
            </field>
            <!-- Tickets -->
            <xpath expr="//field[@name='shift_ticket_ids']/tree" position="inside">
                <field name="shift_max_available_seats" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='shift_ticket_ids']/tree/field[@name='seats_max']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'readonly': [('shift_max_available_seats', '=', 'auto')]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
