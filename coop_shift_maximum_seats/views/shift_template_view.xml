<?xml version="1.0" ?>
<odoo>
    <record id="view_shift_template_form_inherit" model="ir.ui.view">
        <field name="model">shift.template</field>
        <field
            name="inherit_id"
            ref="coop_membership.view_shift_template_form_inherit"
        />
        <field name="arch" type="xml">
            <field name="seats_availability" position="attributes">
                <attribute
                    name="readonly"
                >shift_max_available_seats == 'auto'</attribute>
            </field>
            <!-- Tickets -->
            <xpath
                expr="//field[@name='shift_ticket_ids']/list/field[@name='seats_max']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >shift_max_available_seats == 'auto'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
