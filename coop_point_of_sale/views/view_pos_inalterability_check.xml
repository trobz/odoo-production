<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pos_inalterability_check_form" model="ir.ui.view">
        <field name="name">pos.inalterability.check.form</field>
        <field name="model">pos.inalterability.check</field>
        <field name="arch" type="xml">
            <form string="POS Inalterability Check">
                <header>
                    <button
                        name="action_run_check"
                        string="Print Report"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'pending'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,enqueued,done,failed"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_job"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-tasks"
                            invisible="not queue_job_id"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Job</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" />
                        <field name="create_date" readonly="1" string="Requested on" />
                    </group>
                    <div
                        invisible="state != 'failed'"
                        class="alert alert-danger"
                        role="alert"
                    >
                        <strong>Check failed:</strong>
                        <field name="error_message" readonly="1" />
                    </div>
                    <group invisible="state != 'done'">
                        <field
                            name="pdf_report"
                            filename="pdf_filename"
                            widget="binary"
                            string="Report PDF"
                            readonly="1"
                        />
                        <field name="pdf_filename" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_inalterability_check_list" model="ir.ui.view">
        <field name="name">pos.inalterability.check.list</field>
        <field name="model">pos.inalterability.check</field>
        <field name="arch" type="xml">
            <list string="POS Inalterability Checks" default_order="create_date desc">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="create_date" string="Requested on" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'done'"
                    decoration-warning="state in ('pending', 'enqueued')"
                    decoration-danger="state == 'failed'"
                />
            </list>
        </field>
    </record>

    <record id="action_pos_inalterability_check" model="ir.actions.act_window">
        <field name="name">POS Inalterability Checks</field>
        <field name="res_model">pos.inalterability.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Hide the standard l10n_fr_pos_cert menu (synchronous PDF rendering) and
         expose the queue-based check instead. -->
    <record
        id="l10n_fr_pos_cert.menu_check_move_integrity_reporting"
        model="ir.ui.menu"
    >
        <field name="active" eval="False" />
    </record>

    <menuitem
        id="menu_pos_inalterability_check"
        name="POS Inalterability Check"
        parent="l10n_fr_pos_cert.pos_fr_statements_menu"
        action="action_pos_inalterability_check"
        sequence="90"
    />
</odoo>
