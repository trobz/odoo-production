<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="coop_point_of_sale.SaleDetailsReport"
        t-inherit="point_of_sale.SaleDetailsReport"
        t-inherit-mode="extension"
    >
        <!-- pos.user is independent of pos_hr; get_cashier() is overridden by pos_hr so avoid it -->
        <xpath expr="//div[normalize-space(text())='SOLD:']" position="before">
            <h4 class="pos-receipt-center-align fw-bold">Cashier: <t
                t-out="pos.user.name"
            /></h4>
            <br />
        </xpath>
    </t>

</templates>
