<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="coop_point_of_sale.ClosePosPopup"
        t-inherit="point_of_sale.ClosePosPopup"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[@t-on-click='downloadSalesReport']" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
        <xpath expr="//button[contains(@t-on-click, 'cashMove')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>

</templates>
